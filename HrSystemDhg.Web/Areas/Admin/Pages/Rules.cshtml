@page
@model HrSystemDhg.Web.Pages.Admin.RulesModel
@{ViewData["Title"]="Work calendars & deduction rules";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Work calendars & deduction rules</h1>
<div asp-validation-summary="All"></div>
<p>Effective rules resolve by shift, then department, then branch, then global default.</p><form method="post" class="card"><h2>New effective rule</h2><div class="grid"><label>Effective from<input asp-for="Rule.EffectiveFrom" type="date"/></label><label>Branch<select asp-for="Rule.BranchId"><option value="">Global</option>@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select></label><label>Department<select asp-for="Rule.DepartmentId"><option value="">All</option>@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name</option>}</select></label><label>Shift<select asp-for="Rule.ShiftId"><option value="">Any</option>@foreach(var s in Model.Shifts){<option value="@s.Id">@s.Name</option>}</select></label><label>Daily paid hours<input asp-for="Rule.DailyHours" type="number" min="1" max="20" step="0.25"/></label><label>Start hour<input asp-for="Rule.StartHour" type="number" min="0" max="23"/></label><label>Start minute<input asp-for="Rule.StartMinute" type="number" min="0" max="59"/></label><label>Break minutes<input asp-for="Rule.BreakMinutes" type="number" min="0" max="180"/></label><label>Grace minutes<input asp-for="Rule.GraceMinutes" type="number" min="0"/></label><label>Weekday numbers (Sun=0 … Sat=6)<input asp-for="Rule.WorkingWeekdays" placeholder="1,2,3,4,5"/></label><label>Incomplete punch policy<select asp-for="Rule.IncompletePolicy"><option>Flag</option><option>Absent</option><option>Half day</option></select></label><label>Overtime multiplier<input asp-for="Rule.OvertimeMultiplier" type="number" min="0" step="0.1"/></label><label class="inline"><input asp-for="Rule.WeekendOvertime"/> Weekend work eligible for overtime</label><label>Absence daily-rate multiplier<input asp-for="Absence" type="number" min="0" step="0.01"/></label><label>Late / early deduction per minute<input asp-for="Late" type="number" min="0" step="0.01"/></label></div><button>Save effective rules</button></form><div class="card table-scroll"><h2>Work rule history</h2><table><tr><th>Effective</th><th>Scope</th><th>Hours</th><th>Start</th><th>Weekdays</th><th>Incomplete</th></tr>@foreach(var r in Model.Rules){<tr><td>@r.EffectiveFrom.ToString("dd MMM yyyy")</td><td>Branch @(r.BranchId?.ToString()??"all"), dept @(r.DepartmentId?.ToString()??"all"), shift @(r.ShiftId?.ToString()??"all")</td><td>@r.DailyHours</td><td>@r.StartHour:@r.StartMinute.ToString("00")</td><td>@r.WorkingWeekdays</td><td>@r.IncompletePolicy</td></tr>}</table></div><div class="grid"><form method="post" asp-page-handler="Shift" class="card"><h2>Add shift</h2><label>Name<input name="name" required/></label><button>Create shift</button></form><form method="post" asp-page-handler="Holiday" class="card"><h2>Add public holiday</h2><label>Name<input name="name" required/></label><label>Date<input name="date" type="date" required/></label><label>Branch<select name="branchId"><option value="">All branches</option>@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select></label><button>Add holiday</button></form></div><div class="card"><h2>Holidays</h2>@foreach(var h in Model.Holidays){<form method="post" asp-page-handler="RemoveHoliday" class="inline"><input type="hidden" name="id" value="@h.Id"/><span>@h.Date.ToString("dd MMM yyyy") · @h.Name</span><button>Remove holiday</button></form>}</div>