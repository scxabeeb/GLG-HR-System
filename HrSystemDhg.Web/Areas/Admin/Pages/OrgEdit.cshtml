@page
@model HrSystemDhg.Web.Pages.Admin.OrgEditModel
@{ViewData["Title"]="Organization editor";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Organization editor</h1>
<div asp-validation-summary="All"></div>
<p>Edit details or deactivate an organization unit. Historical employee and payroll records are retained.</p><form method="post" class="card"><input type="hidden" asp-for="Kind"/><input type="hidden" asp-for="Id"/><label>Unit type<select asp-for="Kind" disabled><option>Branch</option><option>Department</option><option>SubDepartment</option></select></label><div class="grid"><label>Name<input asp-for="Name" required/></label>@if(Model.Kind!="SubDepartment"){<label>Code<input asp-for="Code" required/></label>}@if(Model.Kind=="Branch"){<label>City<input asp-for="City"/></label><label>Address<input asp-for="Address"/></label><label>IANA timezone<input asp-for="Timezone" required/></label>}@if(Model.Kind=="Department"){<label>Branch<select asp-for="ParentId">@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select></label><label class="inline"><input asp-for="RequiresSub"/> Require sub-department</label>}@if(Model.Kind=="SubDepartment"){<label>Department<select asp-for="ParentId">@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name</option>}</select></label>}<label class="inline"><input asp-for="Active"/> Active</label></div><button>Save unit</button></form>