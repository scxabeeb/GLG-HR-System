@page
@model HrSystemDhg.Web.Pages.Admin.OrgEditModel
@{var unitLabel=Model.Kind=="SubDepartment"?"Sub-department":Model.Kind; var plural=Model.Kind=="Branch"?"Branches":Model.Kind=="Department"?"Departments":"Sub-departments"; ViewData["Title"]=unitLabel+" registration";}
<div class="eyebrow">ADMINISTRATION / ORGANIZATION</div><h1>@unitLabel registration</h1>
<nav class="workspace-tabs" aria-label="Organization units"><a asp-page="./OrgEdit" asp-route-kind="Branch" class="@(Model.Kind=="Branch"?"is-active":"")">Branches</a><a asp-page="./OrgEdit" asp-route-kind="Department" class="@(Model.Kind=="Department"?"is-active":"")">Departments</a><a asp-page="./OrgEdit" asp-route-kind="SubDepartment" class="@(Model.Kind=="SubDepartment"?"is-active":"")">Sub-departments</a><a asp-page="./Organization">Organization structure</a></nav>
<div class="actions"><a href="#organization-form" class="button secondary">Registration form</a><a href="#organization-list" class="button secondary">Registered @plural.ToLowerInvariant()</a></div>
@if(TempData["OrganizationNotice"] is string notice){<p class="notice" role="status">@notice</p>}
<partial name="/Pages/Shared/_RegistrationCsv.cshtml" model='("organization units")' />

<div asp-validation-summary="All"></div>
<section id="organization-form"><h2>@(Model.Id>0?"Edit "+unitLabel.ToLowerInvariant():"Register "+unitLabel.ToLowerInvariant())</h2><p>Save details below. Registered units appear in the list underneath. Linked units can be deactivated to retain their history.</p><form method="post" class="card"><input type="hidden" asp-for="Kind"/><input type="hidden" asp-for="Id"/><label>Unit type<select asp-for="Kind" disabled><option>Branch</option><option>Department</option><option>SubDepartment</option></select></label><div class="grid"><label>Name<input asp-for="Name" required/></label>@if(Model.Kind!="SubDepartment"){<label>Code<input asp-for="Code" required/></label>}@if(Model.Kind=="Branch"){<label>City (optional)<input asp-for="City"/></label><label>Address (optional)<input asp-for="Address"/></label><label>IANA timezone<input asp-for="Timezone" required/></label>}@if(Model.Kind=="Department"){<label>Branch<select asp-for="ParentId">@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select></label><label class="inline"><input asp-for="RequiresSub"/> Require sub-department</label>}@if(Model.Kind=="SubDepartment"){<label>Department<select asp-for="ParentId">@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name</option>}</select></label>}<label class="inline"><input asp-for="Active"/> Active</label></div><div class="actions"><button>Save unit</button>@if(Model.Id>0){<a class="button secondary" asp-page="./OrgEdit" asp-route-kind="@Model.Kind" asp-fragment="organization-form">Cancel edit / new unit</a>}</div></form></section>

<section class="card" id="organization-list">
<header class="workspace-list-heading"><h2>Registered @plural.ToLowerInvariant()</h2><small>@Model.UnitRows.Count() records</small></header>
<form method="get" class="actions"><input type="hidden" name="Kind" value="@Model.Kind"/><label>Find @plural.ToLowerInvariant()<input asp-for="Search" placeholder="Name, code or parent unit" type="search"/></label><button class="secondary">Search</button><a asp-page="./OrgEdit" asp-route-kind="@Model.Kind" asp-fragment="organization-list">Clear</a></form>
<div class="table-scroll"><table class="workspace-table"><thead><tr><th>Name / location</th><th>Code</th><th>Parent unit</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach(var unit in Model.UnitRows){<tr data-organization-unit="@unit.Id"><td><strong>@unit.Name</strong>@if(!string.IsNullOrWhiteSpace(unit.Location)){<small>@unit.Location</small>}</td><td>@(string.IsNullOrEmpty(unit.Code)?"—":unit.Code)</td><td>@(string.IsNullOrEmpty(unit.Parent)?"—":unit.Parent)</td><td><span class="badge">@(unit.Active?"Active":"Inactive")</span></td><td><div class="actions"><a asp-page="./OrgEdit" asp-route-kind="@Model.Kind" asp-route-id="@unit.Id" asp-fragment="organization-form">Edit</a><form method="post" asp-page-handler="Delete" asp-route-kind="@Model.Kind" asp-route-id="@unit.Id" onsubmit="return confirm('Delete this unused unit? Units linked to records cannot be deleted.');"><button class="secondary">Delete</button></form></div></td></tr>}
</tbody></table></div>
@if(!Model.UnitRows.Any()){<p>No @plural.ToLowerInvariant() match this view. Clear the search or register a unit above.</p>}
</section>
