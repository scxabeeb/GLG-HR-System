@page
@model HrSystemDhg.Web.Pages.Admin.DevicesModel
@using HrSystemDhg.Web.Services
@using HrSystemDhg.Web.Pages.Admin
@{ ViewData["Title"] = "Attendance devices"; }
<div class="eyebrow">ADMINISTRATION / ATTENDANCE</div>
<h1>Attendance devices</h1>


<p>Register one terminal for each branch or location. All paired terminals upload into the shared attendance register. Use a unique employee PIN consistently on every terminal.</p>
<p>Pair a compatible ZKTeco ADMS terminal for automatic punches, or register a device for manual and CSV imports.</p>
@if (TempData["DeviceNotice"] is string message) { <p class="notice" role="status">@message</p> }
<div class="page-workspace" data-page-workspace><nav class="workspace-tabs" aria-label="Device settings views"><a href="#devices-list" data-workspace-link>Registered devices</a><a href="#devices-register" data-workspace-link>Register device</a><a href="#devices-config" data-workspace-link>Device configuration</a><a href="#devices-setup" data-workspace-link>Connection guide</a><a href="#devices-import" data-workspace-link>Import &amp; export</a></nav>
<section id="devices-list" data-workspace-panel><section class="card">
    <h2>Registered devices <span class="badge">@Model.Items.Count</span></h2>
    <p>@Model.Items.Count(d => DevicesModel.ConnectionStatus(d) == "Online") online · @Model.Items.Count(d => DevicesModel.ConnectionStatus(d) is "Offline" or "Not connected") offline / waiting · @Model.Items.Count(d => d.PushSerial == null) not paired</p>
    <form method="get" class="actions"><label>Connection status<select asp-for="Connection"><option value="">All devices</option><option value="online">Online</option><option value="offline">Offline / not connected</option><option value="unpaired">Not paired</option></select></label><button class="secondary">Apply</button><a asp-page="./Devices" asp-route-connection="@Model.Connection" class="button secondary">Refresh status</a></form>
    <p class="muted">Only registered terminals appear here. Online means the paired terminal contacted the server within the last five minutes. Not paired devices support manual and CSV imports.</p>
    @if (Model.Items.Count == 0) { <p>No devices registered yet. Add a terminal below.</p> }
    else
    {
        <div class="table-scroll">
            <table>
                <thead><tr><th>Device</th><th>Branch</th><th>Office / location</th><th>Serial number</th><th>IP address</th><th>Status</th><th>Last contact (EAT)</th><th>Last upload (EAT)</th><th>Error</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var registered in Model.ListedDevices)
                {
                    var branch = Model.Branches.FirstOrDefault(b => b.Id == registered.BranchId);

                    <tr>
                        <td><strong>@registered.Name</strong><br /><small>#@registered.Id · @registered.Endpoint</small></td>
                        <td>@(branch?.Name ?? "Unassigned branch")</td>
                        <td>@(registered.Location ?? "—")</td>
                        <td>@(registered.PushSerial ?? "—")</td>
                        <td>@(registered.PushAddress ?? "—")</td>
                        <td><span class="badge @(DevicesModel.ConnectionStatus(registered) == "Online" ? "status-positive" : "status-warning")">@DevicesModel.ConnectionStatus(registered)</span></td>
                        <td>@(registered.LastPushSeenUtc is DateTime contact ? OperationsPolicy.Local(contact).ToString("dd MMM yyyy, HH:mm") : "—")</td>
                        <td>@(registered.LastSuccess is DateTime uploaded ? OperationsPolicy.Local(uploaded).ToString("dd MMM yyyy, HH:mm") : "—")</td>
                        <td>@(registered.LastError ?? "—")</td>
                        <td><div class="actions"><a href="#device-@registered.Id">Edit / configure</a><form method="post" asp-page-handler="Delete" asp-route-id="@registered.Id" onsubmit="return confirm('Delete this unused device registration?')"><button class="secondary">Delete device</button></form></div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p><small>Recent contact means the terminal contacted the system within the last five minutes. Refresh to update.</small></p>
        @if (!Model.ListedDevices.Any()) { <p>No devices match this connection filter.</p> }
    }
</section>

</section><section id="devices-register" data-workspace-panel><form method="post" class="card">
    <h2>Register a terminal</h2>
    <div class="grid"><label>Device name<input name="name" required maxlength="200" /></label><label>Branch<select name="branchId" required><option value="">Choose branch</option>@foreach(var branch in Model.Branches){<option value="@branch.Id">@branch.Name</option>}</select></label><label>Reference<input name="endpoint" /></label><label>Office / location<input name="location" maxlength="250" /></label></div>
    <button>Add device</button>
</form></section><section id="devices-config" data-workspace-panel><h2>Device configuration</h2><p>Expand a registered device to manage its branch, network pairing, employee sync and enrollment commands.</p>
@if(Model.Items.Count == 0){<p class="notice">No devices registered. <a href="#devices-register">Register a device</a> to configure its connection.</p>}
<div class="device-configurations">@foreach (var device in Model.Items)
{
    <details class="card workspace-tools" id="device-@device.Id"><summary>@device.Name · @(device.Location ?? device.Endpoint) · #@device.Id</summary><article>
        <h2>@device.Name <span class="badge">#@device.Id</span></h2>
        <p>@device.Endpoint · @(device.PushSerial == null ? "Manual / CSV" : "Paired for ADMS")</p>
        <form method="post" asp-page-handler="Edit" asp-route-id="@device.Id">
            <div class="grid"><label>Device name<input name="name" value="@device.Name" required maxlength="200"/></label><label>Reference<input name="endpoint" value="@device.Endpoint"/></label></div>
            <div class="grid">
                <label>Branch<select name="branchId" required><option value="">Choose branch</option>
                    @foreach (var branch in Model.Branches) {
                        <option value="@branch.Id" selected="@(branch.Id == device.BranchId)">@branch.Name · #@branch.Id</option>
                    }
                </select></label>
                <label>Office / location<input name="location" value="@device.Location" maxlength="250" /></label>
            </div>
            <button class="secondary">Save device</button>
        </form>
        @if (device.PushSerial != null)
        {
            <p>Last contact: @(device.LastPushSeenUtc is DateTime seen ? OperationsPolicy.Local(seen).ToString("dd MMM yyyy, HH:mm") + " EAT" : "Waiting for terminal")<br />
            Last upload: @(device.LastSuccess is DateTime upload ? OperationsPolicy.Local(upload).ToString("dd MMM yyyy, HH:mm") + " EAT" : "No punches received")</p>
            @if (device.LastError != null) { <p class="notice">@device.LastError</p> }
        }
        <form method="post" asp-page-handler="Push" asp-route-id="@device.Id">
            <div class="grid">
                <label>Terminal serial number<input name="serial" value="@device.PushSerial" maxlength="64" required /></label>
                <label>Terminal IP address<input name="address" value="@device.PushAddress" placeholder="192.168.1.50" required /></label>
            </div>
            <button>Save ADMS pairing</button>
            @if (device.PushSerial != null) { <button class="secondary" name="disable" value="true" formnovalidate>Disable automatic sync</button> }
        </form>
        @if (device.PushSerial != null)
        {
            <section class="card"><h3>Office connector → online system</h3><p>For the Railway system, run the connector on the office computer connected to the terminal. It forwards punches and enrollment commands over HTTPS.</p>
            <p>Connector: @(device.OfficeConnectorKeyHash == null ? "Not configured" : device.LastOfficeConnectorSeenUtc >= DateTime.UtcNow.AddMinutes(-2) ? "Online" : "Waiting / offline") · Last heartbeat: @(device.LastOfficeConnectorSeenUtc is DateTime beat ? OperationsPolicy.Local(beat).ToString("dd MMM yyyy HH:mm:ss") + " EAT" : "—")</p>
            <a class="button secondary" asp-page-handler="ConnectorScript">Download connector script</a>
            <form method="post" asp-page-handler="Connector" asp-route-id="@device.Id"><button>Download / rotate connector configuration</button>@if(device.OfficeConnectorKeyHash != null){<button class="secondary" name="revoke" value="true">Revoke connector</button>}</form>
            <p class="muted">The configuration contains a device-specific secret. Keep it on the office computer. Downloading a new configuration replaces the previous key.</p>
            <code>python3 attendance_connector.py --config attendance-connector-@(device.Id).json</code>
            <p>On the terminal: ADMS, server address = office computer’s Ethernet IP, port = 5190, HTTPS = OFF for this private LAN connector. The terminal’s own IP stays unchanged.</p></section>
        }
        @if (device.PushSerial != null)
        {
            <form method="post" asp-page-handler="Employee" asp-route-id="@device.Id">
                <h3>Employee sync and fingerprint enrollment</h3>
                <p>Assign a unique ZKTeco PIN when registering the employee in HR. Send the profile to create or update a normal user on the terminal. Confirm the PIN belongs to that employee on the terminal before sending.</p>
                <div class="grid">
                    <label>Employee
                        <select name="employeeId" required>
                            <option value="">Select an employee</option>
                            @foreach (var employee in Model.Employees)
                            {
                                <option value="@employee.Id">@employee.FullName · PIN @employee.ZkPin</option>
                            }
                        </select>
                    </label>
                    <label>Fingerprint slot
                        <select name="fingerSlot">
                            @for (var slot = 0; slot < 10; slot++) { <option value="@slot">@(slot + 1)</option> }
                        </select>
                    </label>
                </div>
                <button name="operation" value="sync">Send employee to terminal</button>
                <button name="operation" value="enroll" class="secondary">Start fingerprint enrollment</button>
                <p>Wait for the profile to be acknowledged before enrolling a new terminal user. Have the employee stand at the reader and follow its prompts.</p>
            </form>
            <h3>Recent terminal commands</h3>
            @foreach (var command in Model.Commands.Where(c => c.DeviceId == device.Id))
            {
                var status = command.Result switch {
                    0 => "Terminal acknowledged success",
                    int code => $"Terminal returned {code}",
                    _ when command.ExpiresUtc <= DateTime.UtcNow => command.SentUtc == null ? "Expired before sending" : "No terminal acknowledgement",
                    _ => command.SentUtc == null ? "Queued" : "Sent · awaiting terminal"
                };
                <p>@(command.FingerSlot == null ? "Employee sync" : "Fingerprint enrollment") · PIN @command.Pin · @status</p>
            }
        }
    </article></details>
}
</div></section><section id="devices-setup" data-workspace-panel><div class="card">
    <h2>Automatic attendance setup</h2>
    <ol>
        <li>Connect the terminal to the office network. Record its serial number and private IP address.</li>
        <li>Under the terminal below, enter those details and save pairing.</li>
        <li>On the terminal, open COMM → ADMS or Cloud Server. Enter the HR server’s office IP and dedicated device port (5190 in the setup guide). Use the server’s LAN address, not 127.0.0.1.</li>
        <li>Make a test punch. Check the last upload here and the result in <a asp-area="Hr" asp-page="/Attendance">Attendance</a>. Map the terminal’s user ID if it appears in the unmapped PIN queue.</li>
    </ol>
    <p>A physical terminal cannot reach the localhost server. Start the dedicated device listener on the HR host’s office interface first.</p>
</div>
</section><section id="devices-import" data-workspace-panel><partial name="/Pages/Shared/_RegistrationCsv.cshtml" model='("attendance devices")' /></section></div>
