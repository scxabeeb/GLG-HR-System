@page
@model HrSystemDhg.Web.Pages.Admin.SettingsModel
@inject HrSystemDhg.Web.Services.PortalBranding Branding
@{ViewData["Title"]="Main settings";}
<div class="eyebrow">ADMINISTRATION</div><h1>Main settings</h1><p class="page-intro">Manage your organization, working policies and access from one place.</p>
@if(TempData["Success"] is string message){<div class="notice" role="status">@message</div>}
<div asp-validation-summary="All"></div>
<div class="page-workspace" data-page-workspace>
<nav class="workspace-tabs" aria-label="Settings sections"><a href="#settings-general" data-workspace-link>General</a><a href="#settings-hr" data-workspace-link>HR &amp; attendance</a><a href="#settings-access" data-workspace-link>Users &amp; security</a><a href="#settings-messages" data-workspace-link>Communications</a><a href="#settings-modules" data-workspace-link>Modules &amp; reports</a></nav>
<section id="settings-general" data-workspace-panel>

<form method="post" class="card"><h2>General preferences</h2><p>These policies apply across the organization.</p><label>Organization name<input asp-for="Input.CompanyName" required maxlength="200"/></label><div class="grid"><label>Full system name<input asp-for="Input.PortalName" required maxlength="160" /></label><label>Short name<input asp-for="Input.ShortName" required maxlength="60" /></label><label>Subtitle<input asp-for="Input.PortalSubtitle" required maxlength="80" /></label></div><hr/>
<label class="inline"><input asp-for="Input.AllowFutureHires"/> Allow future-dated hires</label><p>Register employees before their employment start date.</p>
<p>HR submits leave requests for final approval by the General Secretary.</p>
<label class="inline"><input asp-for="Input.ManagementBankAccess"/> Allow Management to export bank details</label><p>HR and Admin retain access to bank exports.</p><button>Save preferences</button></form>
<form method="post" asp-page-handler="Logo" enctype="multipart/form-data" class="card"><h2>Organization logo</h2><p>The logo appears on the web sign-in screen, navigation and browser icon. Use a PNG or JPEG up to 1 MB.</p><img src="@((await Branding.GetAsync()).LogoUrl)" alt="Current organization logo" width="80" height="80" style="object-fit:contain" /><label>New logo<input type="file" name="logo" accept="image/png,image/jpeg" /></label><div class="actions"><button>Upload logo</button><button class="secondary" name="remove" value="true">Restore default logo</button></div></form>
<header class="hub-section-heading"><h2>Organization structure</h2><p>Manage branches, departments and office structure.</p></header>
<div class="hub-grid focused-hub-grid"><a class="hub-card" href="/Admin/Organization"><h2>Organization structure</h2><p>Add and edit branches, departments and sub-departments. Deactivate units no longer in use.</p></a></div></section>
<section id="settings-hr" data-workspace-panel>
<header class="hub-section-heading"><h2>HR &amp; attendance</h2><p>Set work schedules, payroll deductions, leave policies and attendance devices.</p></header>
<div class="hub-grid focused-hub-grid"><a class="hub-card" href="/Admin/LeaveTypes"><h2>Leave policies</h2><p>Manage leave types, allowances and approval requirements.</p></a><a class="hub-card" href="/Admin/Rules"><h2>Attendance &amp; payroll rules</h2><p>Change check-in/out windows, working days, required hours, breaks and salary-based or fixed deduction rates.</p></a><a class="hub-card" href="/Admin/Devices"><h2>Attendance devices</h2><p>Register terminals, configure ADMS pairing, set department and location, and manage employee sync.</p></a></div></section>
<section id="settings-access" data-workspace-panel>
<header class="hub-section-heading"><h2>Users &amp; security</h2><p>Manage sign-in access, permissions, recovery and audit history.</p></header>
<div class="hub-grid focused-hub-grid"><a class="hub-card" href="/Admin/Users"><h2>Users & permissions</h2><p>Create accounts, grant or revoke roles, and control branch access.</p></a><a class="hub-card" asp-page="./PasswordResets"><h2>Password reset requests</h2><p>Review account recovery requests.</p></a><a class="hub-card" href="/Admin/Audit"><h2>Activity & audit</h2><p>Review account, configuration and HR changes.</p></a><a class="hub-card" asp-page="./Support"><h2>Support view</h2><p>Open an authorized support session.</p></a></div></section>
<section id="settings-messages" data-workspace-panel>
<header class="hub-section-heading"><h2>Communications</h2><p>Configure staff messaging and review delivery.</p></header>
<div class="hub-grid focused-hub-grid"><a class="hub-card" asp-page="./WhatsApp"><h2>WhatsApp &amp; staff messages</h2><p>Send staff messages and check the business sender and delivery queue.</p></a></div></section>
<section id="settings-modules" data-workspace-panel><header class="hub-section-heading"><h2>Module management &amp; report configuration</h2><p>Open the relevant workspace to manage records, workflows, configuration and exports.</p></header><div class="hub-grid focused-hub-grid">
<a class="hub-card" asp-page="./ReportViews"><h2>Report designer</h2><p>Create, edit or disable named reports. Choose a dataset, columns, date range and default filters.</p></a>
<a class="hub-card" asp-area="Hr" asp-page="/Employees"><h2>Employees &amp; onboarding</h2><p>Register staff, link accounts, upload documents and manage terminal enrollment.</p></a>
<a class="hub-card" asp-area="Hr" asp-page="/Attendance"><h2>Attendance management</h2><p>Review punches, map device PINs, correct records, approve overtime and rebuild summaries.</p></a>
<a class="hub-card" asp-area="Hr" asp-page="/Salary"><h2>Salary configuration</h2><p>Maintain effective salary versions, allowances and payment details.</p></a>
<a class="hub-card" asp-area="Management" asp-page="/Payroll"><h2>Payroll &amp; waivers</h2><p>Generate monthly payroll, review deductions, apply waivers and publish payslips.</p></a>
<a class="hub-card" asp-area="Hr" asp-page="/Balances"><h2>Leave credits</h2><p>Set individual entitlements and review remaining leave.</p></a>
<a class="hub-card" asp-area="" asp-page="/Operations/Tasks"><h2>Task management</h2><p>Manage assignments, teams, subtasks and progress.</p></a>
<a class="hub-card" asp-area="" asp-page="/Operations/Meetings" asp-route-mode="manage"><h2>Meeting management</h2><p>Schedule meetings, invite participants, manage agendas and minutes.</p></a>
<a class="hub-card" asp-area="" asp-page="/Assets/Index"><h2>Assets</h2><p>Register equipment, assign custody and update condition or status.</p></a>
<a class="hub-card" asp-area="" asp-page="/Operations/Fleet"><h2>Fleet</h2><p>Manage vehicles, drivers, service and GPS configuration.</p></a>
</div></section>
</div>
