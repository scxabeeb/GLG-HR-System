@page
@model HrSystemDhg.Web.Pages.Admin.UsersModel
@{ViewData["Title"]="Users & permissions";}
<div class="eyebrow">ADMINISTRATION / ACCESS CONTROL</div><h1>Users & permissions</h1><p class="page-intro">Create accounts and control what each person can access. Role changes invalidate existing sessions within one minute. Disabling an account blocks its next request.</p>
@if(TempData["Success"] is string message){<div class="notice" role="status">@message</div>}
<div asp-validation-summary="All"></div>
<details class="card"><summary>Understand role permissions</summary><div class="table-scroll"><table class="permission-guide"><thead><tr><th>Role</th><th>Access granted</th></tr></thead><tbody><tr><td>Admin</td><td>System settings, users, organization, all HR and payroll operations.</td></tr><tr><td>HR</td><td>Employee records, salary registration, attendance, leave decisions, reports and publication of locked payslips.</td></tr><tr><td>Management</td><td>Attendance, leave, payroll calculation and approval, and reports. Bank export requires a separate system preference.</td></tr><tr><td>Employee</td><td>Own profile, attendance, leave requests and published payslips. Assigned managers can approve team leave.</td></tr></tbody></table></div><p>Roles combine their permissions. Branch restrictions limit staff data access. Admin has organization-wide access. Removing roles preserves the account and its audit history.</p></details>
<details class="card" id="create-account"><summary>+ Add a user</summary><form method="post" asp-page-handler="Create"><p>Use a temporary password of at least 10 characters with uppercase, lowercase, number and symbol. Operational roles require an employee record.</p><div class="grid"><label>Email<input name="email" type="email" required maxlength="256" autocomplete="off"/></label><label>Temporary password<input name="password" type="password" minlength="10" required autocomplete="new-password"/></label><label>Initial role<select name="role"><option>Employee</option><option>HR</option><option>Management</option><option>Admin</option></select></label><label>Link employee<select name="employeeId"><option value="">No employee (Admin only)</option>@foreach(var e in Model.Employees){<option value="@e.Id">@e.EmployeeNumber</option>}</select></label></div><button>Create user</button></form></details>
<form method="get" class="search-form"><label>Find a user<input asp-for="Search" placeholder="Search by email"/></label><button>Search</button><a class="button secondary" href="/Admin/Users">Clear</a></form><p class="user-count">@Model.Items.Count account(s) found</p>
@foreach(var u in Model.Items){var own=u.Id==Model.CurrentUserId;
<div class="card user-card"><div class="user-heading"><div><h2>@u.Email</h2><p>@(string.IsNullOrEmpty(Model.Roles.GetValueOrDefault(u.Id))?"No roles assigned":Model.Roles[u.Id]) @(own?"· Your account":"")</p></div><span class="badge">@(u.IsEnabled?"Active":"Disabled")</span></div>
<details><summary>Manage permissions</summary><div class="grid"><form method="post" asp-page-handler="Role" class="access-form"><h3>Role permissions</h3><input type="hidden" name="id" value="@u.Id"/><label>Role<select name="role"><option>Employee</option><option>HR</option><option>Management</option><option>Admin</option></select></label><div class="actions"><button name="remove" value="false">Grant role</button><button class="secondary" name="remove" value="true">Revoke role</button></div><p>You cannot revoke your own Admin role.</p></form>
@if(!own){<div class="access-form"><h3>Account access</h3><p>Disable access while retaining employee records and history.</p><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@u.Id"/><button class="secondary">@(u.IsEnabled?"Disable account":"Enable account")</button></form><hr/><form method="post" asp-page-handler="Revoke"><input type="hidden" name="id" value="@u.Id"/><button class="danger">Revoke all roles</button><p>Removes every role. The account can still sign in to its own workspace.</p></form></div>}
</div>
@if(!own){<form method="post" asp-page-handler="Scope" class="access-form"><h3>Branch access</h3><input type="hidden" name="id" value="@u.Id"/><p>Select branches to limit HR and Management access. No selection means access to all branches.</p><div class="checkbox-list">@foreach(var b in Model.Branches){<label><input type="checkbox" name="branches" value="@b.Id" checked="@Model.Scopes.Any(s=>s.UserId==u.Id&&s.BranchId==b.Id)"/>@b.Name</label>}</div><button>Save branch access</button></form>}
</details></div>}
@if(Model.Items.Count==0){<div class="card"><h2>No users found</h2><p>Try another email or clear your search.</p></div>}
