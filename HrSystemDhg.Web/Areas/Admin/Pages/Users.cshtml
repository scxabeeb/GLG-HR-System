@page
@using HrSystemDhg.Web.Services
@model HrSystemDhg.Web.Pages.Admin.UsersModel
@{ViewData["Title"]="Users & permissions";}
<div class="eyebrow">ADMINISTRATION / ACCESS CONTROL</div><h1>Users & permissions</h1>
<partial name="/Pages/Shared/_RegistrationCsv.cshtml" model='("user accounts")' />
<p class="page-intro">Create accounts and control what each person can access. Role changes invalidate existing sessions within one minute. Disabling an account blocks its next request.</p>
@if(TempData["Success"] is string message){<div class="notice" role="status">@message</div>}
<div asp-validation-summary="All"></div>
<details class="card"><summary>Understand role permissions</summary><div class="table-scroll"><table class="permission-guide"><thead><tr><th>Role</th><th>Access granted</th></tr></thead><tbody><tr><td>Admin</td><td>System settings, users, organization, HR administration and payroll review, submission and payment. Final payroll approval requires the General Secretary role.</td></tr><tr><td>HR</td><td>Employee records, salary registration, attendance, leave submission, reports and publication of locked payslips.</td></tr><tr><td>Finance</td><td>Review generated payroll, submit to the General Secretary, return it to HR with a reason, and record payment after approval.</td></tr><tr><td>Management</td><td>Attendance, leave, payroll viewing, and reports. Bank export requires a separate system preference.</td></tr><tr><td>General Secretary</td><td>All Management access, plus final approval of leave and payroll submitted for executive approval.</td></tr><tr><td>Employee</td><td>Own profile, attendance, leave requests and published payslips. HR submits requests for final approval.</td></tr></tbody></table></div><p>Roles combine their permissions. Branch restrictions limit staff data access. Admin has organization-wide access. Removing roles preserves the account and its audit history.</p></details>
<details class="card" id="create-account"><summary>+ Add a user</summary><form method="post" asp-page-handler="Create"><p>Enter a username, an email address, or both. An email address enables email password recovery. Use a temporary password of at least 10 characters with uppercase, lowercase, number and symbol. Employee profile is optional for every role. Link a profile to enable personal attendance, leave requests and payslips. General Secretary includes Management access automatically.</p><div class="grid"><label>Username<input name="username" maxlength="256" autocomplete="off" placeholder="e.g. secretary"/></label><label>Email address<input name="email" type="email" maxlength="256" autocomplete="off" placeholder="Optional when username is supplied"/></label><label>Temporary password<input name="password" type="password" minlength="10" required autocomplete="new-password"/></label><label>Initial role<select name="role"><option>Employee</option><option>HR</option><option>Management</option><option>Finance</option><option value="General Secretary">General Secretary + Management</option><option>Chairman</option><option>Admin</option></select></label><label>Link employee (optional)<select name="employeeId"><option value="">No employee profile (optional)</option>@foreach(var e in Model.Employees){<option value="@e.Id">@e.EmployeeNumber · @e.FullName</option>}</select></label></div><button>Create user</button></form></details>
<form method="get" class="search-form"><label>Find a user<input asp-for="Search" placeholder="Name, employee ID, username or email"/></label><button>Search</button><a class="button secondary" href="/Admin/Users">Clear</a></form><p class="user-count">@Model.Items.Count account(s) found</p>
@foreach(var u in Model.Items){var own=u.Id==Model.CurrentUserId;
<div class="card user-card"><div class="user-heading"><div><h2>@(u.UserName ?? u.Email)</h2><p>@(u.Email ?? "No recovery email registered")</p><p>@(string.IsNullOrEmpty(Model.Roles.GetValueOrDefault(u.Id))?"No roles assigned":Model.Roles[u.Id]) @(own?"· Your account":"")</p></div><span class="badge">@(u.IsEnabled?"Active":"Disabled")</span></div>
<details><summary>Manage permissions</summary>@if(u.EmployeeId==null){<form method="post" asp-page-handler="Link" class="access-form"><h3>Link an employee profile</h3><p>This account can use its assigned roles. Link a profile for personal employee records.</p><input type="hidden" name="id" value="@u.Id"/><label>Available employee<select name="employeeId" required><option value="">Select an employee</option>@foreach(var employee in Model.Employees){<option value="@employee.Id">@employee.EmployeeNumber · @employee.FullName</option>}</select></label><button>Link profile</button></form>}<div class="grid"><form method="post" asp-page-handler="Role" class="access-form"><h3>Role permissions</h3><input type="hidden" name="id" value="@u.Id"/><label>Role<select name="role"><option>Employee</option><option>HR</option><option>Management</option><option>Finance</option><option value="General Secretary">General Secretary + Management</option><option>Chairman</option><option>Admin</option></select></label><div class="actions"><button name="remove" value="false">Grant role</button><button class="secondary" name="remove" value="true">Revoke role</button></div><p>You cannot revoke your own Admin role. General Secretary always includes Management; revoke General Secretary to remove its inherited access.</p></form>
@if(!own){<div class="access-form"><h3>Account access</h3><p>Disable access while retaining employee records and history.</p><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@u.Id"/><button class="secondary">@(u.IsEnabled?"Disable account":"Enable account")</button></form><hr/><form method="post" asp-page-handler="Revoke"><input type="hidden" name="id" value="@u.Id"/><button class="danger">Revoke all roles</button><p>Removes every role. The account can still sign in to its own workspace.</p></form></div>}
</div>
@if(!own && !(Model.Roles.GetValueOrDefault(u.Id) ?? "").Split(", ").Contains("Admin")){
<form method="post" asp-page-handler="MenuAccess" class="access-form menu-permission-form">
    <h3>Menus &amp; submenus</h3>
    <p>Allow keeps access granted by the user’s roles and branch scope. Deny blocks the page, its actions and mobile endpoints. Denying a whole module overrides its submenus. Administrators retain full access.</p>
    <input type="hidden" name="id" value="@u.Id"/>
    @foreach(var module in ModuleAccess.Modules) {
        <details class="permission-module">
        <summary>@module.Label <span class="muted">@(Model.Restricted.GetValueOrDefault(u.Id)?.Contains(module.Key)==true ? "Module denied" : "Role access")</span></summary>
        <label class="permission-choice"><strong>Entire module</strong><select name="access[@module.Key]" aria-label="@module.Label module access"><option value="Allow" selected="@(Model.Restricted.GetValueOrDefault(u.Id)?.Contains(module.Key)!=true)">Allow</option><option value="Deny" selected="@(Model.Restricted.GetValueOrDefault(u.Id)?.Contains(module.Key)==true)">Deny</option></select></label>
        @foreach(var item in MenuPermissions.Items.Where(x=>x.Module==module.Key)) {
            <label class="permission-choice"><span>@item.Label</span><select name="access[@item.Key]" aria-label="@item.Label access"><option value="Allow" selected="@(Model.Restricted.GetValueOrDefault(u.Id)?.Contains(item.Key)!=true)">Allow</option><option value="Deny" selected="@(Model.Restricted.GetValueOrDefault(u.Id)?.Contains(item.Key)==true)">Deny</option></select></label>
        }
        </details>
    }
    <button>Save menu permissions</button>
</form>
}
@if(!own){<form method="post" asp-page-handler="Scope" class="access-form"><h3>Branch access</h3><input type="hidden" name="id" value="@u.Id"/><p>Select branches to limit HR and Management access. No selection means access to all branches.</p><div class="checkbox-list">@foreach(var b in Model.Branches){<label><input type="checkbox" name="branches" value="@b.Id" checked="@Model.Scopes.Any(s=>s.UserId==u.Id&&s.BranchId==b.Id)"/>@b.Name</label>}</div><button>Save branch access</button></form>}
</details></div>}
@if(Model.Items.Count==0){<div class="card"><h2>No users found</h2><p>Try another email or clear your search.</p></div>}
