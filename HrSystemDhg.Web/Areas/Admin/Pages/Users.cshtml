@page
@using HrSystemDhg.Web.Services
@model HrSystemDhg.Web.Pages.Admin.UsersModel
@{ViewData["Title"]="Users & permissions";}
<div class="users-page" data-no-section-index>
<div class="users-title"><div><div class="eyebrow">ADMINISTRATION / ACCESS CONTROL</div><h1>Users &amp; permissions</h1><p class="page-intro">Manage accounts, responsibilities and access in one place.</p></div><div class="actions"><a class="button secondary" asp-page="./Roles">Manage roles</a><a class="button" href="#create-account">+ Add account</a></div></div>
<div class="users-overview" aria-label="Account overview"><div><span>Matching accounts</span><strong>@Model.Items.Count</strong></div><div><span>Active</span><strong>@Model.Items.Count(u => u.IsEnabled)</strong></div><div><span>Inactive</span><strong>@Model.Items.Count(u => !u.IsEnabled)</strong></div><a href="#access-guide"><strong>Access guide →</strong><span>Understand roles and permissions</span></a></div>
<partial name="/Pages/Shared/_RegistrationCsv.cshtml" model='("user accounts")' />

@if(TempData["Success"] is string message){<div class="notice" role="status">@message</div>}
<div asp-validation-summary="All"></div>
<details class="card" id="create-account"><summary><strong>Create an account</strong><span class="users-hint">Username, initial role and optional employee profile</span></summary><form method="post" asp-page-handler="Create"><p>Enter a username, an email address, or both. An email address enables email password recovery. Use a temporary password of at least 4 characters. Employee profile is optional for every role. Link a profile to enable personal attendance, leave requests and payslips. General Secretary includes Management access automatically.</p><div class="grid"><label>Username<input name="username" maxlength="256" autocomplete="off" placeholder="e.g. secretary"/></label><label>Email address<input name="email" type="email" maxlength="256" autocomplete="off" placeholder="Optional when username is supplied"/></label><label>Temporary password<input name="password" type="password" minlength="4" required autocomplete="new-password"/></label><label>Initial role<select name="role">@foreach(var role in Model.AvailableRoles){<option value="@role" selected="@(role=="Employee")">@role</option>}</select></label><label>Link employee (optional)<select name="employeeId"><option value="">No employee profile (optional)</option>@foreach(var e in Model.Employees){<option value="@e.Id">@e.EmployeeNumber · @e.FullName</option>}</select></label></div><button>Create user</button></form></details>

<div class="users-directory"><div><h2>Account directory</h2><p>Open an account to edit access. Employees can hold several roles.</p></div><form method="get" class="search-form"><label>Find a user<input asp-for="Search" placeholder="Name, employee ID, username or email"/></label><button>Search</button><a class="button secondary" href="/Admin/Users">Clear</a></form></div>
<div data-registration-list="users">
@foreach(var u in Model.Items){var own=u.Id==Model.CurrentUserId;
<div class="card user-card"><details class="user-editor"><summary class="user-row"><span class="user-monogram" aria-hidden="true">@((u.UserName ?? u.Email ?? "U").Substring(0,1).ToUpperInvariant())</span><div class="user-heading"><div><h2>@(u.UserName ?? u.Email)</h2><p class="user-email">@(u.Email ?? "No recovery email")</p>@if(Model.LinkedEmployees.TryGetValue(u.Id,out var profile)){<p><strong>@profile.FullName</strong> · @profile.EmployeeNumber</p>}<p>@(string.IsNullOrEmpty(Model.Roles.GetValueOrDefault(u.Id))?"No roles assigned":Model.Roles[u.Id]) @(own?"· Your account":"")</p></div><span class="badge @(u.IsEnabled?"user-active":"user-inactive")">@(u.IsEnabled?"Active":"Inactive")</span></div><span class="user-row-action">Manage <span aria-hidden="true">⌄</span></span></summary><div class="user-editor-body"><nav class="user-section-nav" aria-label="Account controls"><a href="#roles-@u.Id">Roles</a>@if(!own){@if(Model.AssignedRoles.GetValueOrDefault(u.Id)?.Contains("Admin") != true){<a href="#menus-@u.Id">Menu access</a>}<a href="#branches-@u.Id">Branches</a><a href="#security-@u.Id">Security</a>}@if(u.EmployeeId==null){<a href="#profile-@u.Id">Employee link</a>}</nav><div class="user-editor-note">Changes apply to this account. Role and password changes end existing sessions.</div>@if(u.EmployeeId==null){<form method="post" asp-page-handler="Link" class="access-form" id="profile-@u.Id"><h3>Link an employee profile</h3><p>This account can use its assigned roles. Link a profile for personal employee records.</p><input type="hidden" name="id" value="@u.Id"/><label>Available employee<select name="employeeId" required><option value="">Select an employee</option>@foreach(var employee in Model.Employees){<option value="@employee.Id">@employee.EmployeeNumber · @employee.FullName</option>}</select></label><button>Link profile</button></form>}<div class="grid"><form method="post" asp-page-handler="Roles" class="access-form" id="roles-@u.Id"><h3>Roles &amp; responsibilities</h3><p>Select all roles this person needs.</p><input type="hidden" name="id" value="@u.Id"/><div class="checkbox-list">@foreach(var role in Model.AvailableRoles){<label><input type="checkbox" name="roles" value="@role" checked="@(Model.AssignedRoles.GetValueOrDefault(u.Id)?.Contains(role)==true)"/>@role</label>}</div><button>Save assigned roles</button><p>The employee profile is retained. Keep your own Admin role. General Secretary includes Management.</p></form>
@if(!own){<div class="access-form" id="security-@u.Id"><h3>Security &amp; sign-in</h3><p>Disable access while retaining employee records and history.</p><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@u.Id"/><button class="secondary">@(u.IsEnabled?"Disable account":"Enable account")</button></form><hr/><details><summary>Set temporary password</summary><form method="post" asp-page-handler="ResetPassword"><input type="hidden" name="id" value="@u.Id"/><label>New temporary password<input type="password" name="password" required minlength="4" maxlength="128" autocomplete="new-password"/></label><label>Confirm temporary password<input type="password" name="confirm" required minlength="4" maxlength="128" autocomplete="new-password"/></label><button>Reset password</button><p>Existing sessions end. The user must choose a new password after signing in.</p></form></details><hr/><form method="post" asp-page-handler="Revoke"><input type="hidden" name="id" value="@u.Id"/><button class="danger">Revoke all roles</button><p>Removes every role. The account can still sign in to its own workspace.</p></form></div>}
</div>
@if(!own && !(Model.Roles.GetValueOrDefault(u.Id) ?? "").Split(", ").Contains("Admin")){
<form method="post" asp-page-handler="MenuAccess" class="access-form menu-permission-form" id="menus-@u.Id">
    <h3>Menu access</h3><p class="users-hint">Fine-tune individual menus and submenus.</p>
    <p>Inherit uses the assigned roles. Allow overrides a role denial within the user’s operational capabilities; Deny blocks access. A denied parent menu blocks its submenus. Branch scope and workflow rules still apply. Admin retains full access.</p>
    <input type="hidden" name="id" value="@u.Id"/>
    <partial name="/Pages/Shared/_PermissionMatrix.cshtml" model="@(new PermissionMatrix(Model.UserAccess.GetValueOrDefault(u.Id) ?? [],true,Model.InheritedDenied.GetValueOrDefault(u.Id)))"/>
    <button>Save menu permissions</button>
</form>
}
@if(!own){<form method="post" asp-page-handler="Scope" class="access-form" id="branches-@u.Id"><h3>Branch access</h3><input type="hidden" name="id" value="@u.Id"/><p>Select branches to limit HR and Management access. No selection means access to all branches.</p><div class="checkbox-list">@foreach(var b in Model.Branches){<label><input type="checkbox" name="branches" value="@b.Id" checked="@Model.Scopes.Any(s=>s.UserId==u.Id&&s.BranchId==b.Id)"/>@b.Name</label>}</div><button>Save branch access</button></form>}
@if(own){<p><a asp-area="Identity" asp-page="/Account/ChangePassword">Change my password</a></p>}
</div></details></div>}
</div>
@if(Model.Items.Count==0){<div class="card"><h2>No users found</h2><p>Try another email or clear your search.</p></div>}

<details class="card" id="access-guide"><summary>Understand role permissions</summary><div class="table-scroll"><table class="permission-guide"><thead><tr><th>Role</th><th>Access granted</th></tr></thead><tbody><tr><td>Admin</td><td>System settings, users, organization, HR administration and payroll review, submission and payment. Final payroll approval requires the General Secretary role.</td></tr><tr><td>HR</td><td>Employee records, salary registration, attendance, leave submission, reports and publication of locked payslips.</td></tr><tr><td>Finance</td><td>Review generated payroll, submit to the General Secretary, return it to HR with a reason, and record payment after approval.</td></tr><tr><td>Management</td><td>Attendance, leave, payroll viewing, and reports. Bank export requires a separate system preference.</td></tr><tr><td>General Secretary</td><td>All Management access, plus final approval of leave and payroll submitted for executive approval.</td></tr><tr><td>Employee</td><td>Own profile, attendance, leave requests and published payslips. HR submits requests for final approval.</td></tr></tbody></table></div><p>Roles combine their permissions. Branch restrictions limit staff data access. Admin has organization-wide access. Removing roles preserves the account and its audit history.</p></details>

</div>
