@page
@model HrSystemDhg.Web.Pages.Admin.PasswordResetsModel
@{ViewData["Title"]="Local password reset requests";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Local password reset requests</h1><p>Development-only delivery. Reset links are private and expire after one hour. Configure SMTP for email delivery.</p><div class="card table-scroll"><table><tr><th>Account</th><th>Requested (UTC)</th><th>Action</th></tr>@foreach(var item in Model.Items){<tr><td>@item.Email</td><td>@item.CreatedUtc.ToString("g")</td><td><a href="@item.Link" rel="noreferrer">Open reset form</a></td></tr>}</table>@if(Model.Items.Count==0){<p>No active local reset requests.</p>}</div>
