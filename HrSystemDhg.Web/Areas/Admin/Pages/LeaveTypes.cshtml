@page
@model HrSystemDhg.Web.Pages.Admin.LeaveTypesModel
@{ViewData["Title"]="Leave types & policy";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Leave types & policy</h1>
<div asp-validation-summary="All"></div>
<form method="post" class="card"><input type="hidden" asp-for="Input.Id"/><h2>@(Model.Input.Id==0?"New leave type":"Edit leave type")</h2><div class="grid"><label>Name<input asp-for="Input.Name" required/></label><label>Annual entitlement (days)<input asp-for="Input.AnnualDays" type="number" step="0.01" min="0"/></label><label>Minimum days<input asp-for="Input.MinDays" type="number" min="1"/></label><label>Maximum days<input asp-for="Input.MaxDays" type="number" min="1"/></label><label>Gender restriction<input asp-for="Input.GenderRestriction" placeholder="Blank for all"/></label><label>Employment restriction<input asp-for="Input.EmploymentRestriction" placeholder="Blank for all"/></label><label class="inline"><input asp-for="Input.IsPaid"/> Paid leave</label><label class="inline"><input asp-for="Input.EnforceBalance"/> Enforce balance</label><label class="inline"><input asp-for="Input.AccrueMonthly"/> Accrue monthly</label><label class="inline"><input asp-for="Input.RequiresDocument"/> Supporting document required</label></div><button>Save leave type</button></form><div class="card"><table><tr><th>Name</th><th>Pay</th><th>Days/year</th><th>Actions</th></tr>@foreach(var t in Model.Types){<tr><td>@t.Name</td><td>@(t.IsPaid?"Paid":"Unpaid")</td><td>@t.AnnualDays</td><td><a href="?id=@t.Id">Edit</a></td></tr>}</table></div>