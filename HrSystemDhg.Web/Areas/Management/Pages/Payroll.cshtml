@page
@using HrSystemDhg.Web.Services
@model HrSystemDhg.Web.Pages.Management.PayrollModel
@{ViewData["Title"]="Payroll workspace"; var noticeMessage=TempData["PayrollNotice"] as string; var noticePanel=TempData["PayrollNoticePanel"] as string;}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Payroll workspace</h1>

<div asp-validation-summary="All" role="alert"></div>
@if (Model.MissingRule is { } missing)
{
    <section class="card" aria-labelledby="payroll-work-rule">
        <h2 id="payroll-work-rule">Which work rule should apply?</h2>
        <p>Payroll needs an effective work rule for <strong>@Model.Names.GetValueOrDefault(missing.EmployeeId)</strong>
            on <strong>@missing.Date.ToString("dd MMM yyyy")</strong>. The calculation was rolled back.</p>
        @if (User.IsInRole("Admin"))
        {
            <a class="button" asp-area="Admin" asp-page="/Rules"
               asp-route-effective="@missing.Date.ToString("yyyy-MM-dd")"
               asp-route-branchId="@missing.Assignment.BranchId" asp-route-departmentId="@missing.Assignment.DepartmentId"
               asp-route-shiftId="@missing.Assignment.ShiftId" asp-route-payrollId="@Model.RulePeriodId">Configure work rule</a>
        }
        else
        {
            <p>Ask an administrator to configure a rule effective on or before this date, then retry.</p>
        }
        <form method="post" asp-page-handler="Calculate" class="actions">
            <input type="hidden" name="id" value="@Model.RulePeriodId" />
            <input type="hidden" name="SalaryDays" value="@Model.SalaryDays" />
            <input type="hidden" name="firstGenerationOnly" value="@(Model.FirstGenerationOnly ? "true" : "false")" />
            <input type="hidden" name="Month" value="@Model.Month" />
            <input type="hidden" name="PayrollBranchId" value="@Model.PayrollBranchId" />
            <input type="hidden" name="apply" value="@(Model.ApplyDeductions ? "true" : "false")" />
            <button class="secondary">Retry calculation</button>
        </form>
    </section>
}

@{
    var p = Model.SelectedPeriod;
    var lines = Model.Lines.ToDictionary(l => l.EmployeeId);
    var deductions = Model.Deductions.ToLookup(d => d.PayrollLineId);
    var selection = new Dictionary<string, string> { ["Month"] = Model.Month };
    if (Model.PayrollBranchId is int branch) selection["PayrollBranchId"] = branch.ToString();
    if (p != null) selection["PeriodId"] = p.Id.ToString();
}
@if(p is { Revision: > 0, AttendanceSalaryDays: null } && p.Status is "Draft" or "Calculated")
{
    <p class="notice">This run still shows the previous calculation. Open <a href="#payroll-manage">Generate &amp; manage</a> and choose <strong>Recalculate payroll</strong> with 26 salary days to apply full basic salary and minute deductions.</p>
}
<nav class="workspace-shortcuts" aria-label="Payroll shortcuts"><a href="#payroll-runs"><strong>@Model.Periods.Count payroll periods</strong><span>Choose a run to view or manage</span></a><a href="#payroll-register"><strong>Employee payroll</strong><span>Salaries, deductions and payslips</span></a><a href="#payroll-manage"><strong>Generate / recalculate</strong><span>Prepare and approve payroll</span></a><a href="#payroll-waivers"><strong>Deduction waivers</strong><span>Review employee or selected-day waivers</span></a></nav>
<div class="page-workspace" data-page-workspace><nav class="workspace-tabs" aria-label="Payroll views"><a href="#payroll-runs" data-workspace-link>Payroll periods</a><a href="#payroll-register" data-workspace-link>Employee payroll</a><a href="#payroll-manage" data-workspace-link>Generate &amp; manage</a><a href="#payroll-waivers" data-workspace-link>Deduction waivers</a><a href="#payroll-import" data-workspace-link>Import &amp; export</a>@if(Model.CanReport){<a asp-area="" asp-page="/Reports/Index" asp-route-report="Payroll">Reports</a>}</nav>
<section id="payroll-register" data-workspace-panel>
@if(noticeMessage!=null && noticePanel!="payroll-manage"){<p class="notice payroll-success" role="status">@noticeMessage</p>}
<section class="card">
    <h2>Select payroll</h2>
    <p><strong>Approval workflow:</strong> HR generates → Admin / Finance reviews and submits → General Secretary approves → Admin / Finance records payment. Rejections return to the previous stage with a reason.</p>
    <form method="get" class="actions">
        <label>Payroll month<input asp-for="Month" type="month" required /></label>
        <label>Branch
            <select asp-for="PayrollBranchId" required="@Model.Scoped">
                @if (!Model.Scoped) { <option value="">All branches</option> }
                @foreach (var branch in Model.Branches) { <option value="@branch.Id">@branch.Name</option> }
            </select>
        </label>
        <button class="secondary">Apply filters</button>
    </form>


    <details class="payroll-policy"><summary>Calculation rules &amp; attendance deductions</summary><p>Generation uses the displayed month and branch. The registered basic salary stays unchanged. Attendance deductions are calculated separately using basic salary ÷ the run’s salary days (default 26) ÷ required daily minutes × missing minutes, then subtracted when calculating net pay. Basic salary and registered allowances are paid in full; employment-date proration is not applied. Only scheduled days within employment dates are checked for attendance deductions. With 26 salary days and an eight-hour day, the formula is basic ÷ 26 ÷ 480 × missing minutes.</p><p>Complete check-in and check-out pairs use actual worked minutes immediately. Missing check-in or check-out stays pending until the check-out window closes in East Africa Time, then counts as absence for the unexcused time. Future days are not charged. Recalculate an unapproved payroll after attendance closes or new punches arrive.</p></details>
</section><section class="card workspace-list" id="@(p == null ? "employee-payroll" : $"payroll-{p.Id}")">
    <header class="workspace-list-heading"><h2>Employee payroll @if (p != null) { <span class="badge @(p.Status == "Paid" ? "status-positive" : "")">@PayrollWorkflow.Label(p.Status)</span> }</h2><small>@Model.SalaryRows.Count employees shown</small></header>

    @if (Model.SalaryRows.Count == 0)
    {
        <p>No employees match this selection.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="payroll-table workspace-table">
                <thead><tr><th>Employee</th><th>Basic salary</th><th>Allowances</th><th>Gross</th><th>Attendance deducted</th><th>Unpaid leave</th><th>Net pay</th><th>Details &amp; payslip</th></tr></thead>
                <tbody>
                @foreach (var employee in Model.SalaryRows)
                {
                    var line = lines.GetValueOrDefault(employee.Id);
                    var salary = employee.Salary;
                    var allowances = salary == null ? (decimal?)null : salary.Housing + salary.Transport + salary.Allowances;
                    var currency = line?.Currency ?? salary?.Currency;
                    string Money(decimal? amount) => amount.HasValue ? $"{currency} {amount:N2}" : "—";
                    <tr>
                        <td><strong>@employee.Name</strong> <small>· @employee.Number</small></td>
                        <td>@Money(line?.Basic ?? salary?.Basic)</td><td>@Money(line?.AllowanceTotal ?? allowances)</td>
                        <td>@Money(line?.Gross ?? (salary?.Basic + allowances))</td>
                        <td>@if(line != null){<button type="button" class="payroll-deduction-link" data-payroll-details="payroll-detail-@line.Id" aria-label="View attendance deduction breakdown for @employee.Name">@Money(line.AttendanceApplied)</button>}else{<span>—</span>}</td><td>@Money(line?.UnpaidLeave)</td>
                        <td class="payroll-net"><strong>@Money(line?.Net)</strong>
                            @if (line == null) { <br /><small>@(!employee.Complete ? "Onboarding incomplete" : salary == null ? "Published salary required" : "Ready to calculate")</small> }
                        </td>
                        <td>
                        @if (line != null)
                        {
                            <div class="actions">
                                <button type="button" class="secondary" data-payroll-details="payroll-detail-@line.Id">Details</button>
                                @if(Model.CanViewPayslips){<a class="button secondary" asp-area="" asp-page="/Me/Payslip" asp-route-id="@line.Id">Payslip</a>}
                            </div>
                            <dialog id="payroll-detail-@line.Id" class="payroll-detail" aria-labelledby="payroll-title-@line.Id">
                                <header class="payroll-detail-heading">
                                    <div><h2 id="payroll-title-@line.Id">@employee.Name</h2>
                                    <p>@employee.Number · @p?.From.ToString("dd MMM yyyy") – @p?.To.ToString("dd MMM yyyy")</p></div>
                                    <form method="dialog"><button class="secondary" autofocus>Close</button></form>
                                </header>
                                <dl class="payroll-summary">
                                    <div><dt>Gross earnings</dt><dd>@Money(line.Gross)</dd></div>
                                    <div><dt>Attendance deducted</dt><dd>@Money(line.AttendanceApplied)</dd></div>
                                    <div><dt>Net pay</dt><dd>@Money(line.Net)</dd></div>
                                </dl>
                                <p>Approved overtime @Money(line.Overtime) · Unpaid leave @Money(line.UnpaidLeave)</p>
                                <h3>Attendance deductions</h3>
                                @if (!deductions[line.Id].Any()) { <p>No attendance deductions were calculated.</p> }
                                @if(deductions[line.Id].Any())
                                {
                                    <p class="muted">Amounts and calculation reasons are saved with this payroll revision. Punches, credited hours and missing minutes below show current attendance records.</p>
                                    <div class="table-scroll"><table class="workspace-table payroll-deduction-table"><thead><tr><th>Date</th><th>Cause / attendance</th><th>Saved calculation / reason</th><th>Calculated</th><th>Applied</th><th>Waived</th><th>Manage</th></tr></thead><tbody>
                                    @foreach(var d in deductions[line.Id])
                                    {
                                        var day = Model.Attendance.GetValueOrDefault((employee.Id,d.Date.Date));
                                        <tr><td>@d.Date.ToString("dd MMM yyyy")</td><td><strong>@d.Type</strong>@if(day != null){<details><summary>Current attendance</summary><dl class="deduction-attendance-context"><dt>In (EAT)</dt><dd>@(day.FirstIn?.ToString("hh:mm tt") ?? "—")</dd><dt>Out (EAT)</dt><dd>@(day.LastOut?.ToString("hh:mm tt") ?? "—")</dd><dt>Worked hours</dt><dd>@day.WorkedHours.ToString("0.##")</dd><dt>Missing minutes</dt><dd>@day.MissingMinutes</dd></dl><small>@day.StatusMessage</small></details>}</td><td>@(d.Reason ?? "Automatic calculation")</td><td>@Money(d.Calculated)</td><td>@Money(d.Applied)</td><td>@Money(Math.Max(0,d.Calculated-d.Applied))</td><td>
                                        @if(p?.Status == "Calculated" && Model.CanReview){<details><summary>Adjust</summary><form method="post" asp-page-handler="Adjust" asp-all-route-data="selection" asp-route-deductionId="@d.Id"><label>Applied amount<input name="amount" type="number" min="0" step="0.01" value="@d.Applied" required /></label><label>Reason<input name="reason" required maxlength="500" /></label><button>Save adjustment</button></form></details>}else{<span>Read only</span>}
                                        </td></tr>
                                    }
                                    </tbody><tfoot><tr><th colspan="3">Total attendance deductions</th><td>@Money(deductions[line.Id].Sum(d=>d.Calculated))</td><td>@Money(deductions[line.Id].Sum(d=>d.Applied))</td><td>@Money(deductions[line.Id].Sum(d=>Math.Max(0,d.Calculated-d.Applied)))</td><td></td></tr></tfoot></table></div>
                                }

                                @if (p?.Status == "Calculated" && Model.CanReview)
                                {
                                    <form method="post" asp-page-handler="Override" asp-all-route-data="selection" asp-route-lineId="@line.Id" class="deduction-row">
                                        <label>Net override<input name="amount" type="number" min="0" step="0.01" value="@line.NetOverride" /></label>
                                        <label>Reason<input name="reason" value="@line.OverrideReason" required /></label><button>Save override</button>
                                    </form>
                                }
                            </dialog>
                        }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

</section>
<section id="payroll-runs" data-workspace-panel class="card"><header class="workspace-list-heading"><h2>Payroll periods</h2><small>@Model.Periods.Count registered runs</small></header><p>Open employee payroll to see amounts, or choose Manage to recalculate and follow approvals.</p><div class="table-scroll"><table class="workspace-table"><thead><tr><th>Period</th><th>Branch</th><th>Status</th><th>Revision</th><th>Actions</th></tr></thead><tbody>
@foreach(var run in Model.Periods){<tr data-payroll-period="@run.Id"><td>@run.From.ToString("dd MMM yyyy") – @run.To.ToString("dd MMM yyyy")</td><td>@(run.BranchId.HasValue?Model.Branches.FirstOrDefault(b=>b.Id==run.BranchId)?.Name:"All branches")</td><td><span class="badge">@PayrollWorkflow.Label(run.Status)</span></td><td>@run.Revision</td><td><div class="actions"><a asp-page="./Payroll" asp-route-PeriodId="@run.Id" asp-route-Month="@run.From.ToString("yyyy-MM")" asp-route-PayrollBranchId="@run.BranchId" asp-fragment="payroll-register">Employee payroll</a><a asp-page="./Payroll" asp-route-PeriodId="@run.Id" asp-route-Month="@run.From.ToString("yyyy-MM")" asp-route-PayrollBranchId="@run.BranchId" asp-fragment="payroll-manage">Manage</a></div></td></tr>}
</tbody></table></div>@if(Model.Periods.Count==0){<p>No payroll periods yet. <a href="#payroll-manage">Generate the first payroll</a>.</p>}</section>
<section id="payroll-manage" data-workspace-panel>
@if(noticeMessage!=null && noticePanel=="payroll-manage"){<p class="notice payroll-success" role="status" aria-live="polite"><strong>Success</strong> @noticeMessage</p>}

    <div class="payroll-manage-heading"><div><div class="eyebrow">MONTHLY PAYROLL</div><h2>Payroll approval workflow</h2><p>Prepare the month, review employee amounts, then follow the approval steps.</p></div><a class="button secondary" href="#payroll-runs">Browse payroll periods</a></div>
    @{
        var stage = p?.Status switch { "Calculated" or "Reviewed" => 1, "Submitted" => 2, "Locked" or "Paid" => 3, _ => 0 };
        var stages = new[] { "HR preparation", "Admin / Finance review", "General Secretary approval", "Payment" };
    }
    <ol class="payroll-stage-list" aria-label="Payroll approval stages">
        @for(var i=0;i<stages.Length;i++){<li class="@(p?.Status=="Paid" || i<stage ? "is-complete" : i==stage ? "is-current" : "")" aria-current="@(p!=null && i==stage && p.Status!="Paid" ? "step" : null)"><span>@(i+1)</span><div><strong>@stages[i]</strong><small>@(i==0?"Generate & check":i==1?"Review & submit":i==2?"Approve or return":"Confirm payment")</small></div></li>}
    </ol>
    <div class="payroll-manage-grid @(!Model.CanGenerate?"payroll-manage-single":"")">
        @if(Model.CanGenerate){
        <section class="card payroll-generate-card" aria-labelledby="generate-payroll-title">
            <div class="eyebrow">01 / PREPARE A MONTH</div><h3 id="generate-payroll-title">Generate monthly payroll</h3><p>Select the payroll month and workplace. Generate the period first, then calculate employee amounts from the selected payroll card.</p>
            <form method="post" asp-page-handler="Generate" class="payroll-generation-form">
                <label for="generate-month">Payroll month<input id="generate-month" name="Month" type="month" value="@Model.Month" required/></label>
                <label for="generate-branch">Branch<select id="generate-branch" name="PayrollBranchId" required="@Model.Scoped">
                    @if(!Model.Scoped){<option value="">All branches</option>}
                    @foreach(var branch in Model.Branches.Where(b=>b.IsActive || b.Id==Model.PayrollBranchId)){<option value="@branch.Id" selected="@(Model.PayrollBranchId==branch.Id)">@branch.Name@(branch.IsActive?"":" (inactive)")</option>}
                </select></label>
                <label for="generate-salary-days">Salary days divisor<input id="generate-salary-days" name="SalaryDays" type="number" min="1" max="366" value="@Model.SalaryDays" required/><small>Default 26 days × 480 minutes = 12,480 monthly minutes for an eight-hour day. Deduction = basic salary ÷ 12,480 × missing minutes.</small></label>
                <div class="payroll-generation-note"><strong>One payroll per month and branch</strong><p>An existing payroll opens automatically. Use Recalculate payroll to refresh an existing unapproved run.</p></div>
                <button type="submit" class="payroll-generate-submit">Generate payroll</button>
            </form>
        </section>
        }
        <section class="card payroll-selected-card" id="selected-payroll" aria-labelledby="selected-payroll-title">
            <div class="payroll-selected-heading"><div><div class="eyebrow">@(Model.CanGenerate?"02 / MANAGE A RUN":"SELECTED PAYROLL")</div><h3 id="selected-payroll-title">Selected payroll</h3></div>@if(p!=null){<span class="badge">@PayrollWorkflow.Label(p.Status)</span>}</div>
            @if(Model.Periods.Count>0){<form method="get" asp-fragment="payroll-manage" class="payroll-run-picker"><label for="saved-payroll">Saved payroll<select id="saved-payroll" name="PeriodId">@foreach(var period in Model.Periods){<option value="@period.Id" selected="@(p?.Id==period.Id)">@period.From.ToString("dd MMM") – @period.To.ToString("dd MMM yyyy") · @(period.BranchId is int savedBranchId ? Model.Branches.FirstOrDefault(b=>b.Id==savedBranchId)?.Name : "All branches") · @PayrollWorkflow.Label(period.Status)</option>}</select></label><button class="secondary">Open payroll</button></form>}
            @if(p!=null){
                <dl class="payroll-run-facts"><div><dt>Period</dt><dd>@p.From.ToString("dd MMM yyyy") – @p.To.ToString("dd MMM yyyy")</dd></div><div><dt>Branch</dt><dd>@(p.BranchId is int runBranchId?Model.Branches.FirstOrDefault(b=>b.Id==runBranchId)?.Name:"All branches")</dd></div><div><dt>Employees</dt><dd>@Model.SalaryRows.Count</dd></div><div><dt>Revision</dt><dd>@p.Revision</dd></div><div><dt>Salary days</dt><dd>@(p.AttendanceSalaryDays?.ToString() ?? "Legacy calculation")</dd></div></dl>
                <a class="payroll-view-employees" href="#payroll-register">View employee payroll &amp; deductions →</a>
                @if(Model.CanGenerate && p.Status is "Draft" or "Calculated"){
                <form method="post" asp-page-handler="Calculate" asp-all-route-data="selection" asp-route-id="@p.Id" class="payroll-recalculate-form">
                    <h4>@(p.Status=="Draft"?"Calculate this period":"Refresh this payroll")</h4><p>Review the divisor and attendance option before updating employee amounts.</p>
                    <label for="recalculate-salary-days">Salary days divisor<input id="recalculate-salary-days" name="SalaryDays" type="number" min="1" max="366" value="@Model.SalaryDays" required/></label>
                    @if(Model.CanReview){<label class="inline"><input type="checkbox" name="apply" value="true" checked/> Apply attendance deductions</label>}else{<input type="hidden" name="apply" value="true"/><small>Attendance deductions will be applied.</small>}
                    <button>@(p.Status=="Draft"?"Calculate payroll":"Recalculate payroll")</button>
                </form>}
                <div class="payroll-decision-actions">
                    @if(Model.CanDecide(p.Status,"Submit")){<form method="post" asp-page-handler="Transition" asp-all-route-data="selection" asp-route-id="@p.Id"><button name="action" value="Submit">Review &amp; submit to General Secretary</button></form>}
                    @if(Model.CanDecide(p.Status,"Approve")){<form method="post" asp-page-handler="Transition" asp-all-route-data="selection" asp-route-id="@p.Id"><button name="action" value="Approve">Approve payroll</button></form>}
                    @if(p.Status=="Locked" && Model.CanReview){<form method="post" asp-page-handler="MarkPaid" asp-all-route-data="selection" asp-route-id="@p.Id"><label class="inline"><input type="checkbox" name="confirmed" value="true" required/> Payment has been made</label><button>Mark as paid</button></form>}
                    @if(p.Status is "Locked" or "Paid"){
                        @if(Model.CanPublish){<form method="post" asp-page-handler="Publish" asp-all-route-data="selection" asp-route-id="@p.Id"><button>Publish payslips</button></form>}
                        @if(Model.CanReport){<a class="button secondary" asp-area="" asp-page="/Reports/Index" asp-route-report="Payroll" asp-route-periodId="@p.Id">Payroll report</a>}
                    }
                </div>
                @if(Model.CanDecide(p.Status,"Reject")){<details class="payroll-secondary-action" open="@(!ViewData.ModelState.IsValid)"><summary>Return payroll for correction</summary><form method="post" asp-page-handler="Transition" asp-all-route-data="selection" asp-route-id="@p.Id"><label>Rejection reason<input name="reason" required maxlength="500"/></label><button class="secondary" name="action" value="Reject">@(p.Status=="Submitted"?"Return to Admin / Finance":"Return to HR")</button></form></details>}
                @if(Model.CanDecide(p.Status,"Reopen")){<details class="payroll-secondary-action" open="@(!ViewData.ModelState.IsValid)"><summary>Reopen payroll for correction</summary><form method="post" asp-page-handler="Transition" asp-all-route-data="selection" asp-route-id="@p.Id"><label>Reason to reopen<input name="reason" required/></label><button class="secondary" name="action" value="Reopen">Reopen</button></form></details>}
            }else{<div class="payroll-empty-selection"><strong>No payroll selected</strong><p>Generate a monthly payroll or open a saved period to review amounts and approvals.</p><a href="#payroll-runs">View payroll periods →</a></div>}
        </section>
    </div>
    @if(Model.WorkflowHistory.Count>0){<section class="card payroll-history-card"><details><summary>Approval history <span class="muted">@Model.WorkflowHistory.Count entries</span></summary><div class="table-scroll"><table><thead><tr><th>Time (EAT)</th><th>By</th><th>Action / reason</th></tr></thead><tbody>@foreach(var entry in Model.WorkflowHistory){<tr><td>@OperationsPolicy.Local(entry.At).ToString("dd MMM yyyy HH:mm")</td><td>@entry.Actor</td><td>@entry.Action</td></tr>}</tbody></table></div></details></section>}
</section>
<section id="payroll-waivers" data-workspace-panel><section class="card"><h2>Deduction waivers</h2>    <fieldset class="payroll-waiver">
        <legend>Waive attendance deductions</legend>
        @if (Model.CanReview && p?.Status == "Calculated" && Model.Deductions.Any(d => (d.Type is "Absence" or "Late" or "Missing minutes" or "Incomplete punch") && d.Applied > 0))
        {
            <form method="post" asp-page-handler="WaiveAttendance" asp-all-route-data="selection" asp-route-id="@p.Id">
                <div class="grid">
                    <label>Employee
                        <select name="employeeId" required>
                            <option value="">Choose who to waive deductions for</option>
                            <option value="0">All employees in this payroll</option>
                            @foreach (var employee in Model.SalaryRows.Where(e => lines.TryGetValue(e.Id, out var line) &&
                                deductions[line.Id].Any(d => (d.Type is "Absence" or "Late" or "Missing minutes" or "Incomplete punch") && d.Applied > 0)))
                            {
                                <option value="@employee.Id">@employee.Name · @employee.Number</option>
                            }
                        </select>
                    </label>
                    <label>Waiver reason<input name="reason" maxlength="500" required /></label>
                </div>
                <fieldset>
                    <legend>Waiver dates</legend>
                    <label class="inline"><input type="radio" name="dateScope" value="all" required /> All days in this payroll</label>
                    <label class="inline"><input type="radio" name="dateScope" value="selected" required /> Selected dates</label>
                    <div class="checkbox-list">
                        @foreach (var date in Model.Deductions.Where(d => (d.Type is "Absence" or "Late" or "Missing minutes" or "Incomplete punch") && d.Applied > 0)
                            .Select(d => d.Date.Date).Distinct().Order())
                        {
                            <label class="inline"><input type="checkbox" name="dates" value="@date.ToString("yyyy-MM-dd")" /> @date.ToString("dd MMM yyyy")</label>
                        }
                    </div>
                </fieldset>
                <p>Waives deductions for absences, late arrival, and early departure in this calculation. If you recalculate payroll, review the new deductions before paying.</p>
                <button class="secondary">Apply waiver</button>
            </form>
        }
        else
        {
            <p>@(p?.Status switch
            {
                null => "Select a payroll run below or generate a run for the selected month.",
                "Draft" => "Calculate payroll to see the attendance deductions available for waiver.",
                "Calculated" => "There are no applied attendance deductions to waive in this run.",
                "Paid" => "This payroll run has been paid.",
                _ => "Reopen and recalculate this run before applying a waiver."
            })</p>
        }
    </fieldset></section></section>
<section id="payroll-import" data-workspace-panel><partial name="/Pages/Shared/_RegistrationCsv.cshtml" model='("payroll periods")' /></section>
</div>
@section Scripts {
    <script src="~/js/payroll-details.js" asp-append-version="true" defer></script>
}
