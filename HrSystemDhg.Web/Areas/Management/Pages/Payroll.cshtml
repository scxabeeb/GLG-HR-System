@page
@model HrSystemDhg.Web.Pages.Management.PayrollModel
@{ViewData["Title"]="Payroll workspace";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Payroll workspace</h1>
<div asp-validation-summary="All"></div>
<p>Calculate → review deductions → approve review → lock → publish. Each recalculation keeps a new revision.</p><form method="post" asp-page-handler="Create" class="card"><h2>New period</h2><div class="grid"><label>From<input name="from" type="date" required/></label><label>To<input name="to" type="date" required/></label><label>Working days<input name="days" type="number" min="1" max="31" required/></label><label>Branch<select name="branchId">@if(!Model.Scoped){<option value="">All company</option>}@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select></label></div><button>Create draft</button></form>@foreach(var p in Model.Periods){<div class="card"><h2>@p.From.ToString("dd MMM yyyy") – @p.To.ToString("dd MMM yyyy") <span class="badge">@p.Status · v@(p.Revision)</span></h2><div class="actions">@if(p.Status is "Draft" or "Calculated"){<form method="post" asp-page-handler="Calculate"><input type="hidden" name="id" value="@p.Id"/><label class="inline"><input type="checkbox" name="apply" value="true" checked/> Apply attendance deductions</label><button>Calculate preview</button></form>}@if(p.Status is "Calculated" or "Reviewed"){<form method="post" asp-page-handler="Transition"><input type="hidden" name="id" value="@p.Id"/><button name="action" value="@(p.Status=="Calculated"?"Review":"Lock")">@(p.Status=="Calculated"?"Approve review":"Lock payroll")</button></form>}@if(p.Status is "Locked" or "Paid"){<form method="post" asp-page-handler="Publish"><input type="hidden" name="id" value="@p.Id"/><button>Publish payslips</button></form><a class="button" href="/Reports/Index?periodId=@p.Id">Reports & exports</a>}@if(p.Status=="Locked"){<form method="post" asp-page-handler="Transition"><input type="hidden" name="id" value="@p.Id"/><button name="action" value="Paid">Mark paid</button></form>}@if(p.Status is not ("Draft" or "Paid")){<form method="post" asp-page-handler="Transition"><input type="hidden" name="id" value="@p.Id"/><label>Reason to reopen<input name="reason" required/></label><button name="action" value="Reopen">Reopen</button></form>}</div><div class="table-scroll"><table><tr><th>Employee</th><th>Gross</th><th>Overtime</th><th>Calculated</th><th>Applied</th><th>Unpaid</th><th>Net</th></tr>@foreach(var l in Model.Lines.Where(x=>x.PayrollPeriodId==p.Id&&x.Revision==p.Revision)){<tr><td>@Model.Names.GetValueOrDefault(l.EmployeeId)</td><td>@l.Gross</td><td>@l.Overtime</td><td>@l.AttendanceCalculated</td><td>@l.AttendanceApplied</td><td>@l.UnpaidLeave</td><td>@l.Currency @l.Net</td></tr>}</table></div>@if(p.Status=="Calculated"){<details><summary>Review daily deductions & overrides</summary>@foreach(var line in Model.Lines.Where(l=>l.PayrollPeriodId==p.Id&&l.Revision==p.Revision)){<form method="post" asp-page-handler="Override" class="deduction-row"><input type="hidden" name="lineId" value="@line.Id"/><strong>@Model.Names.GetValueOrDefault(line.EmployeeId) · net override</strong><label>Net amount (empty resets formula)<input name="amount" type="number" min="0" step="0.01" value="@line.NetOverride"/></label><label>Reason<input name="reason" value="@line.OverrideReason" required/></label><button>Save override</button></form>}@foreach(var d in Model.Deductions.Where(d=>Model.Lines.Any(l=>l.Id==d.PayrollLineId&&l.PayrollPeriodId==p.Id&&l.Revision==p.Revision))){<form class="deduction-row" method="post" asp-page-handler="Adjust"><input type="hidden" name="deductionId" value="@d.Id"/><span>Employee @Model.Lines.First(l=>l.Id==d.PayrollLineId).EmployeeId · @d.Date.ToString("dd MMM") · @d.Type · calculated @d.Calculated</span><label>Apply amount<input name="amount" type="number" min="0" step="0.01" value="@d.Applied" required/></label><label>Reason<input name="reason" value="@d.Reason" required/></label><button>Save decision</button></form>}</details>}</div>}