@page
@model HrSystemDhg.Web.Pages.Hr.RegisterModel
@{ViewData["Title"]="Register employee";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Register employee</h1>
<partial name="/Pages/Shared/_EmployeeNavigation.cshtml" model='("register")' />
<p>Imports also generate a new employee ID and login for every employee. Leave Number and InitialPassword blank in the sample.</p>
<details id="employee-import" class="card workspace-tools"><summary>Import &amp; export employees</summary><partial name="/Pages/Shared/_RegistrationCsv.cshtml" model='("employees")' /></details>

@if(!Model.Branches.Any() || !Model.Departments.Any()){<div class="notice">Create an active branch and department in <a href="/Admin/Organization">Organization structure</a> before registration.</div>}
<a class="hub-back" asp-page="./Employees">← Employee directory</a>
<form method="post" class="card employee-sheet" enctype="multipart/form-data">
    <div asp-validation-summary="All" role="alert"></div>
    <header class="employee-sheet-header">
        <div>
            <label class="employee-sheet-name">Full name<input asp-for="Name" placeholder="Employee name" required /></label>
            <div class="grid">
                <label>Employee ID<input value="Automatic — EMP0001, EMP0002…" readonly /><small>Assigned when the employee is saved.</small></label>
                <label>Work email<input asp-for="Email" type="email" autocomplete="off" required /></label>
            </div>
        </div>
        <label class="employee-sheet-photo">Employee photo (optional)
            <img id="registration-photo-preview" alt="Selected employee photo" hidden />
            <input asp-for="Photo" type="file" accept=".jpg,.jpeg,.png" />
            <small>JPG or PNG, up to 10 MB.</small>
        </label>
    </header>
    <nav class="actions employee-sheet-nav" aria-label="Registration sections">
        <a href="#employee-work">Work information</a>
        <a href="#employee-attendance">Attendance</a>
        <a href="#employee-login">Employee sign-in</a>
    </nav>
    <section class="employee-sheet-section" id="employee-work">
        <h2>Work information</h2>
        <div class="grid">
            <label>Job title<input asp-for="Title" required /></label>
            <label>Hire date<input asp-for="Hire" type="date" required /></label>
            <label>Branch<select asp-for="BranchId" required><option value="">Select branch</option>
                @foreach (var branch in Model.Branches) { <option value="@branch.Id">@branch.Name</option> }
            </select></label>
            <label>Department<select asp-for="DepartmentId" required><option value="">Select department</option>
                @foreach (var department in Model.Departments) { <option value="@department.Id">@department.Name</option> }
            </select></label>
            <label>Sub-department<select asp-for="SubDepartmentId"><option value="">None</option>
                @foreach (var department in Model.SubDepartments) { <option value="@department.Id">@department.Name</option> }
            </select></label>
        </div>
    </section>
    <section class="employee-sheet-section" id="employee-attendance">
        <h2>Attendance</h2>
        <div class="grid">
            <label>ZKTeco PIN<input asp-for="Pin" inputmode="numeric" /></label>
@if (Model.Terminals.Count > 0)
{
    <label>Attendance terminal
        <select asp-for="TerminalId">
            <option value="">Choose a terminal</option>
            @foreach (var terminal in Model.Terminals) { <option value="@terminal.Id">@terminal.Name</option> }
        </select>
    </label>
    <p>With a terminal and PIN selected, the profile is sent automatically. Choose a PIN that is free on the terminal.</p>
}
        </div>
    </section>
<fieldset id="employee-login">
    <legend>Employee sign-in</legend>
    <p>The employee can sign in with their work email or employee number. Give them the temporary password privately. They’ll change it at first sign-in.</p>
    <p>Sign-in credentials are created automatically when you save.</p>
    <dl><dt>Username</dt><dd>Employee ID, for example EMP0001</dd><dt>Initial password</dt><dd>Employee ID followed by 123, for example EMP0001123</dd></dl>
    <p>The employee must choose a new password at their first sign-in. Their work email also works for sign-in and password recovery.</p>
</fieldset>
<div class="actions employee-sheet-footer">
    <button type="submit">Create employee and login</button>
    <a class="button secondary" asp-page="./Employees">Cancel</a>
</div>
<p>After saving, you can add private information, education, work history, salary, and documents.</p>
</form>
@section Scripts {<script>
const branch=document.getElementById('BranchId'),department=document.getElementById('DepartmentId'),sub=document.getElementById('SubDepartmentId');
async function loadOptions(select,url,empty){select.replaceChildren(new Option(empty,''));const rows=await(await fetch(url)).json();for(const row of rows)select.add(new Option(row.name,row.id));}
branch.addEventListener('change',()=>{loadOptions(department,'?handler=Departments&branchId='+encodeURIComponent(branch.value),'Select department');sub.replaceChildren(new Option('None',''));});department.addEventListener('change',()=>loadOptions(sub,'?handler=SubDepartments&departmentId='+encodeURIComponent(department.value),'None'));
const photo = document.getElementById('Photo');
const preview = document.getElementById('registration-photo-preview');
let previewUrl;
photo.addEventListener('change', () => {
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    const file = photo.files[0];
    preview.hidden = !file || !['image/jpeg', 'image/png'].includes(file.type);
    if (preview.hidden) {
        preview.removeAttribute('src');
        previewUrl = undefined;
        return;
    }
    previewUrl = URL.createObjectURL(file);
    preview.src = previewUrl;
});
</script>

}
