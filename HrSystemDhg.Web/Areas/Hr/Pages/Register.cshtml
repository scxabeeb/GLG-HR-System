@page
@model HrSystemDhg.Web.Pages.Hr.RegisterModel
@{ViewData["Title"]="Register employee";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Register employee</h1>
@if(!Model.Branches.Any() || !Model.Departments.Any()){<div class="notice">Create an active branch and department in <a href="/Admin/Organization">Organization structure</a> before registration.</div>}
<p>Step 1 of 6 · Select an active assignment and create the employee login. The employee is saved after this step. Optional sections can be skipped and completed later. A published salary is required before payroll eligibility.</p><form method="post" class="card"><div asp-validation-summary="All"></div><div class="grid"><label>Employee number<input asp-for="Number" required/></label><label>Full name<input asp-for="Name" required/></label><label>Work email<input asp-for="Email" type="email" required/></label><label>Hire date<input asp-for="Hire" type="date" required/></label><label>Branch<select asp-for="BranchId" required><option value="">Select branch</option>@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select></label><label>Department<select asp-for="DepartmentId" required><option value="">Select department</option>@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name</option>}</select></label><label>Sub-department<select asp-for="SubDepartmentId"><option value="">None</option>@foreach(var s in Model.SubDepartments){<option value="@s.Id">@s.Name</option>}</select></label><label>Job title<input asp-for="Title" required/></label><label>ZKTeco PIN<input asp-for="Pin"/></label><label>Initial login password<input asp-for="InitialPassword" type="password" required minlength="10"/></label></div><button>Continue to personal details →</button></form>
@section Scripts {<script>
const branch=document.getElementById('BranchId'),department=document.getElementById('DepartmentId'),sub=document.getElementById('SubDepartmentId');
async function loadOptions(select,url,empty){select.replaceChildren(new Option(empty,''));const rows=await(await fetch(url)).json();for(const row of rows)select.add(new Option(row.name,row.id));}
branch.addEventListener('change',()=>{loadOptions(department,'?handler=Departments&branchId='+encodeURIComponent(branch.value),'Select department');sub.replaceChildren(new Option('None',''));});department.addEventListener('change',()=>loadOptions(sub,'?handler=SubDepartments&departmentId='+encodeURIComponent(department.value),'None'));
</script>}
