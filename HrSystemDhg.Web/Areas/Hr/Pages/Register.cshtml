@page
@model HrSystemDhg.Web.Pages.Hr.RegisterModel
@{ViewData["Title"]="Register employee";}
<div class="eyebrow">PEOPLE &amp; ORGANIZATION</div>
<div class="registration-heading" data-no-section-index><div><h1>Register employee</h1><p>Create their employee record. Complete the remaining onboarding information afterward.</p></div><a class="button secondary" asp-page="./Employees">← Employee directory</a></div>
<partial name="/Pages/Shared/_EmployeeNavigation.cshtml" model='("register")' />
<details id="employee-import" class="card workspace-tools"><summary>Import &amp; export employees</summary><p>Use the sample for bulk registration. IDs, terminal PINs and accounts are generated automatically; leave Number, Pin and InitialPassword blank.</p><partial name="/Pages/Shared/_RegistrationCsv.cshtml" model='("employees")' /></details>
@if(!Model.Branches.Any() || !Model.Departments.Any()){<div class="notice">Create an active branch and department in <a href="/Admin/Organization">Organization structure</a> before registration.</div>}
<form method="post" class="employee-sheet employee-registration" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="registration-errors" role="alert"></div>
    <div class="registration-layout">
        <div class="registration-main">
            <section class="card registration-section" id="employee-personal">
                <div class="registration-section-heading"><span class="registration-number" aria-hidden="true">01</span><div><h2>Employee information</h2><p>Start with the employee’s name and work contact.</p></div><span class="registration-required">* Required</span></div>
                <div class="registration-fields">
                    <label>Full name <span class="required-mark">*</span><input asp-for="Name" placeholder="Enter full name" autocomplete="name" required /><span asp-validation-for="Name"></span></label>
                    <label>Work email <span class="required-mark">*</span><input asp-for="Email" type="email" placeholder="name@example.com" autocomplete="off" required /><small>Used for contact and account recovery.</small><span asp-validation-for="Email"></span></label>
                </div>
            </section>
            <section class="card registration-section" id="employee-work">
                <div class="registration-section-heading"><span class="registration-number" aria-hidden="true">02</span><div><h2>Work assignment</h2><p>Choose the office first, then the employee’s department.</p></div></div>
                <div class="registration-fields">
                    <label>Branch / office <span class="required-mark">*</span><select asp-for="BranchId" required><option value="">Select branch</option>@foreach(var branch in Model.Branches){<option value="@branch.Id">@branch.Name</option>}</select><span asp-validation-for="BranchId"></span></label>
                    <label>Department <span class="required-mark">*</span><select asp-for="DepartmentId" required><option value="">Select department</option>@foreach(var department in Model.Departments.Where(d=>d.BranchId==Model.BranchId)){<option value="@department.Id">@department.Name</option>}</select><span asp-validation-for="DepartmentId"></span></label>
                    <label>Sub-department <span class="registration-optional">Optional</span><select asp-for="SubDepartmentId"><option value="">None</option>@foreach(var department in Model.SubDepartments.Where(d=>d.DepartmentId==Model.DepartmentId)){<option value="@department.Id">@department.Name</option>}</select><span asp-validation-for="SubDepartmentId"></span></label>
                    <label>Job title <span class="required-mark">*</span><input asp-for="Title" placeholder="e.g. Administration officer" required /><span asp-validation-for="Title"></span></label>
                    <label>Hire date <span class="required-mark">*</span><input asp-for="Hire" type="date" required /><span asp-validation-for="Hire"></span></label>
                </div>
            </section>
            <section class="card registration-section" id="employee-attendance">
                <div class="registration-section-heading"><span class="registration-number" aria-hidden="true">03</span><div><h2>Attendance setup</h2><p>A terminal PIN is generated automatically when you save.</p></div><span class="registration-optional">Optional</span></div>
                @if(Model.Terminals.Count>0){<label>Attendance terminal<select asp-for="TerminalId"><option value="">Set up later</option>@foreach(var terminal in Model.Terminals){<option value="@terminal.Id">@terminal.Name</option>}</select><small>Select a terminal to queue the employee profile automatically. Fingerprint enrollment follows on the device.</small><span asp-validation-for="TerminalId"></span></label>}
                else{<div class="registration-info">No paired terminals yet. You can register the employee now and configure attendance later.</div>}
            </section>
        </div>
        <div class="registration-aside" role="complementary" aria-label="Employee photo and next steps">
            <section class="card registration-photo-card"><h2>Employee photo</h2><span class="registration-optional">Optional</span><div class="registration-photo-preview"><span id="registration-photo-placeholder" aria-hidden="true"><svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="24" cy="16" r="8"/><path d="M8 42v-4a16 16 0 0 1 32 0v4"/></svg></span><img id="registration-photo-preview" alt="Selected employee photo" hidden /></div><label for="Photo">Upload photo</label><input asp-for="Photo" type="file" accept=".jpg,.jpeg,.png" /><small>JPG or PNG · Maximum 10 MB</small><span asp-validation-for="Photo"></span></section>
            <section class="card registration-next"><span class="registration-auto">AUTOMATIC EMPLOYEE ID</span><h2>EMP0001, EMP0002…</h2><p>Your next available employee ID is assigned when you save.</p><hr/><h3>Continue onboarding afterward</h3><ul><li>Personal &amp; emergency contact details</li><li>Education &amp; work experience</li><li>Salary &amp; bank information</li><li>CV, certificates &amp; documents</li></ul><p>You can skip optional sections and return to them later.</p></section>
        </div>
    </div>
    <div class="card registration-footer"><div><strong>Ready to create this employee?</strong><p>Save the record and continue to onboarding.</p></div><div class="actions"><a class="button secondary" asp-page="./Employees">Cancel</a><button type="submit">Save &amp; continue →</button></div></div>
</form>
@section Scripts {<script>
const branch=document.getElementById('BranchId'),department=document.getElementById('DepartmentId'),sub=document.getElementById('SubDepartmentId');
async function loadOptions(select,url,empty){select.replaceChildren(new Option(empty,''));const rows=await(await fetch(url)).json();for(const row of rows)select.add(new Option(row.name,row.id));}
branch.addEventListener('change',()=>{loadOptions(department,'?handler=Departments&branchId='+encodeURIComponent(branch.value),'Select department');sub.replaceChildren(new Option('None',''));});department.addEventListener('change',()=>loadOptions(sub,'?handler=SubDepartments&departmentId='+encodeURIComponent(department.value),'None'));
const photo = document.getElementById('Photo');
const preview = document.getElementById('registration-photo-preview');
let previewUrl;
photo.addEventListener('change', () => {
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    const file = photo.files[0];
    preview.hidden = !file || !['image/jpeg', 'image/png'].includes(file.type);
    document.getElementById('registration-photo-placeholder').hidden = !preview.hidden;
    if (preview.hidden) {
        preview.removeAttribute('src');
        previewUrl = undefined;
        return;
    }
    previewUrl = URL.createObjectURL(file);
    preview.src = previewUrl;
});
</script>

}
