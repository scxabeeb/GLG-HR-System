@page
@model HrSystemDhg.Web.Pages.Hr.OnboardingModel
@{ViewData["Title"]="Employee onboarding";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Employee onboarding</h1>
<div asp-validation-summary="All"></div><p>Optional sections can be skipped. Skipping leaves the section unchanged; return using the steps above to complete it later.</p>
<nav class="steps">@for(var n=1;n<=6;n++){<a class="@(n==Model.Step?"active":"")" href="/Hr/Onboarding?employeeId=@Model.Employee.Id&step=@n">@n. @Model.Labels[n-1]</a>}</nav><p>@Model.Employee.FullName · @Model.Employee.EmployeeNumber</p><form method="post" enctype="multipart/form-data" class="card"><input type="hidden" asp-for="EmployeeId"/><input type="hidden" asp-for="Step"/>@if(Model.Step==1){<h2>Assignment</h2><p>The assignment was saved when the employee record was created.</p><a href="/Hr/Details?employeeId=@Model.Employee.Id">Review or transfer assignment</a>}else if(Model.Step==2){<h2>Personal details</h2><div class="grid"><label>Gender<select asp-for="Gender"><option value="">Unspecified</option><option>Female</option><option>Male</option></select></label><label>Date of birth<input asp-for="Birth" type="date" min="1900-01-01" max="@HrSystemDhg.Web.Services.BusinessClock.Today.ToString("yyyy-MM-dd")"/></label><label>Nationality<select asp-for="Nationality"><option value="">Select nationality (optional)</option>@foreach(var country in HrSystemDhg.Web.Services.RegistrationChoices.Nationalities){<option value="@country">@country</option>}</select></label><label>National ID / passport<input asp-for="NationalId"/></label><label>Phone<input asp-for="Phone"/></label><label>Personal email<input asp-for="PersonalEmail" type="email"/></label><label>Address<input asp-for="Address"/></label><label>Marital status<select asp-for="Marital"><option value="">Select status (optional)</option>@foreach(var status in HrSystemDhg.Web.Services.RegistrationChoices.MaritalStatuses){<option>@status</option>}</select></label><label>Dependents<input asp-for="Dependents" type="number" min="0"/></label><label>Employment type<select asp-for="Employment"><option>Permanent</option><option>Contract</option><option>Intern</option></select></label><label>Reporting manager<select asp-for="ManagerId"><option value="">None</option>@foreach(var e in Model.Managers){<option value="@e.Id">@e.FullName</option>}</select></label><label>Emergency contact<input asp-for="Emergency"/></label><label>Relation<input asp-for="Relation"/></label><label>Emergency phone<input asp-for="EmergencyPhone"/></label></div>}else if(Model.Step==3){<h2>Education</h2>@foreach(var e in Model.Education){<p>@e.Qualification · @e.Institution · <a href="/Hr/HistoryEdit?kind=Education&id=@e.Id">Edit</a></p>}<div class="grid"><label>Institution<input asp-for="Institution"/></label><label>Qualification<input asp-for="Qualification"/></label><label>Field of study<input asp-for="Field"/></label><label>Start year<input asp-for="StartYear" type="number"/></label><label>End year (blank if in progress)<input asp-for="EndYear" type="number"/></label><label>Grade / GPA<input asp-for="Grade"/></label></div><button name="repeat" value="true">Save & add another education</button>}else if(Model.Step==4){<h2>Previous experience</h2>@foreach(var e in Model.Experience){<p>@e.JobTitle · @e.Employer · <a href="/Hr/HistoryEdit?kind=Experience&id=@e.Id">Edit</a></p>}<div class="grid"><label>Employer<input asp-for="Employer"/></label><label>Job title<input asp-for="JobTitle"/></label><label>Country<input asp-for="Country"/></label><label>From<input asp-for="WorkFrom" type="date"/></label><label>To<input asp-for="WorkTo" type="date"/></label><label>Reference<input asp-for="Reference"/></label><label>Responsibilities<textarea asp-for="Responsibilities"></textarea></label></div><button name="repeat" value="true">Save & add another experience</button>}else if(Model.Step==5){<h2>Salary registration</h2><p>@Model.SalaryCount salary versions registered.</p><a class="button" href="/Hr/Salary?employeeId=@Model.Employee.Id&returnToWizard=true">Register salary & bank details</a>}else{<h2>Documents & completion</h2>@foreach(var d in Model.Documents){<p><a href="/Files/Download?id=@d.Id">@d.Type · @d.OriginalName</a> · <a href="/Hr/HistoryEdit?kind=Document&id=@d.Id">Edit metadata</a></p>}<div class="grid"><label>Document type<select asp-for="DocumentType"><option>Photo</option><option>Contract</option><option>ID copy</option><option>Certificate</option><option>Leave supporting document</option></select></label><label>Document (PDF, JPG, PNG; max 10 MB)<input asp-for="Upload" type="file" accept=".pdf,.jpg,.jpeg,.png"/></label><label>Expiry date<input asp-for="Expiry" type="date"/></label></div><button name="repeat" value="true">Upload & add another</button><p>You can save this employee without salary or documents. Payroll stays disabled until a published salary is added and onboarding is completed.</p>}<hr/>@if(Model.Step>=2 && Model.Step<=5){<button type="submit" asp-page-handler="Skip" formnovalidate class="secondary">Skip this section →</button>} <button> @(Model.Step==6?"Finish & save employee":"Save & continue →")</button></form>