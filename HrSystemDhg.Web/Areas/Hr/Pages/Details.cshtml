@page
@model HrSystemDhg.Web.Pages.Hr.DetailsModel
@if(TempData["Success"] is string message){<div class="notice" role="status">@message</div>}
@{ViewData["Title"]="Employee record";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Employee record</h1>
@if(Model.Employee!=null){<div class="card"><h2>@Model.Employee.FullName</h2><a href="/Hr/Employment?employeeId=@Model.Employee.Id">Employment, shift & status</a><a class="button" href="/Hr/Onboarding?employeeId=@Model.Employee.Id&step=2">Complete / edit onboarding</a><p>@Model.Employee.EmployeeNumber · @Model.Employee.WorkEmail</p><form method="post" asp-page-handler="Update"><input type="hidden" name="employeeId" value="@Model.Employee.Id"/><div class="grid"><label>Full name<input name="fullName" value="@Model.Employee.FullName" required/></label><label>Work email<input name="workEmail" value="@Model.Employee.WorkEmail" type="email" required/></label><label>Phone<input name="phone" value="@Model.Employee.Phone"/></label><label>National ID<input name="nationalId" value="@Model.Employee.NationalId"/></label></div><button>Update profile</button></form></div><div class="grid"><div class="card"><h2>Education</h2>@foreach(var e in Model.Education){<p><strong>@e.Qualification</strong><br/>@e.Institution · @e.FieldOfStudy</p>}<form method="post" asp-page-handler="Education"><input type="hidden" name="employeeId" value="@Model.Employee.Id"/><label>Institution<input name="institution" required/></label><label>Qualification<input name="qualification" required/></label><label>Field of study<input name="field"/></label><button>Add education</button></form></div><div class="card"><h2>Previous experience</h2>@foreach(var e in Model.Experience){<p><strong>@e.JobTitle</strong><br/>@e.Employer · @e.From.ToString("yyyy")</p>}<form method="post" asp-page-handler="Experience"><input type="hidden" name="employeeId" value="@Model.Employee.Id"/><label>Employer<input name="employer" required/></label><label>Job title<input name="title" required/></label><label>From<input name="from" type="date" required/></label><label>To<input name="to" type="date"/></label><button>Add experience</button></form></div></div><div class="card"><h2>Assignment history</h2>@foreach(var a in Model.Assignments){<p>@a.JobTitle · department @a.DepartmentId · @a.EffectiveFrom.ToString("dd MMM yyyy") – @(a.EffectiveTo?.ToString("dd MMM yyyy")??"Current")</p>}<form method="post" asp-page-handler="Transfer"><input type="hidden" name="employeeId" value="@Model.Employee.Id"/><div class="grid"><label>Department<select name="departmentId">@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name</option>}</select></label><label>Sub-department (optional)<select name="subDepartmentId"><option value="">None</option>@foreach(var s in Model.SubDepartments){<option value="@s.Id">@s.Name</option>}</select></label><label>Job title<input name="title" required/></label><label>Effective from<input name="effective" type="date" required/></label></div><button>Save assignment / transfer</button></form></div><div asp-validation-summary="All"></div>}