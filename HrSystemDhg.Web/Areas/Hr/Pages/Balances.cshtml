@page
@model HrSystemDhg.Web.Pages.Hr.BalancesModel
@{ViewData["Title"]="Leave balance credits";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Leave balance credits</h1>
<partial name="/Pages/Shared/_RegistrationCsv.cshtml" model='("leave balances")' />

<div asp-validation-summary="All"></div>
<p>Set a specific employee’s annual allowance for one leave type and year. For example, a 14-day annual leave credit gives that employee 14 days for the selected year. Other employees keep the leave type default. Approved leave on scheduled working days reduces the remaining balance.</p>
<div class="actions">
    <a class="button secondary" asp-page="./Leave" asp-route-viewMode="balances">View used and remaining days</a>
    <a class="button secondary" asp-page="./Leave" asp-route-viewMode="hr">Record or submit a leave request</a>
</div>
<form method="post" class="card"><div class="grid"><label>Employee<select name="employeeId" required><option value="">Select one employee</option>@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName · @e.EmployeeNumber</option>}</select></label><label>Type<select name="typeId" required><option value="">Select leave type</option>@foreach(var t in Model.Types){<option value="@t.Id">@t.Name · @(t.EnforceBalance ? $"{t.AnnualDays:0.##} days default" : "Unlimited")</option>}</select></label><label>Year<input name="year" type="number" value="@HrSystemDhg.Web.Services.BusinessClock.Today.Year" min="2000" max="2200"/></label><label>Credited days<input name="days" type="number" step="0.01" min="0" required/></label><label>Reason<input name="reason" required/></label></div><button>Set annual credit</button></form><div class="card"><table><tr><th>Employee</th><th>Leave type</th><th>Year</th><th>Credit</th></tr>@foreach(var b in Model.Balances){<tr><td>@Model.Employees.FirstOrDefault(e => e.Id == b.EmployeeId)?.FullName</td><td>@Model.Types.FirstOrDefault(t => t.Id == b.LeaveTypeId)?.Name</td><td>@b.Year</td><td>@b.Days</td></tr>}</table></div>
