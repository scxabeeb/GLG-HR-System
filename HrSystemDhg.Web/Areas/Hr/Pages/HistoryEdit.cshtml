@page
@model HrSystemDhg.Web.Pages.Hr.HistoryEditModel
@{ViewData["Title"]="Edit employee history";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Edit employee history</h1>
<div asp-validation-summary="All"></div>
<form method="post" class="card"><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Kind"/>@if(Model.Kind=="Education"){<div class="grid"><label>Institution<input asp-for="Organization" required/></label><label>Qualification<input asp-for="Title" required/></label><label>Field of study<input asp-for="Field"/></label><label>Start year<input asp-for="StartYear" type="number"/></label><label>End year<input asp-for="EndYear" type="number"/></label><label>Grade / GPA<input asp-for="Grade"/></label></div>}else if(Model.Kind=="Experience"){<div class="grid"><label>Employer<input asp-for="Organization" required/></label><label>Job title<input asp-for="Title" required/></label><label>Country<input asp-for="Country"/></label><label>From<input asp-for="From" type="date" required/></label><label>To<input asp-for="To" type="date"/></label><label>Responsibilities<textarea asp-for="Responsibilities"></textarea></label><label>Reference<input asp-for="Reference"/></label></div>}else{<label>Document type<input asp-for="Title" required/></label><label>Expiry date<input asp-for="To" type="date"/></label><a href="/Files/Download?id=@Model.Id">Download document</a>}<p></p><button>Save changes</button></form>