@page
@model HrSystemDhg.Web.Pages.Hr.AttendanceModel
@{ViewData["Title"]="Attendance";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Attendance</h1>
<div asp-validation-summary="All"></div><p class="muted">East Africa Time (UTC+3). Check-in and checkout windows, working days, required hours and deduction rates follow your effective Attendance &amp; Payroll Rules. Missing punches follow the configured review policy.</p>
@if (TempData["RegistrationCsvResult"] is string csvResult)
{
    <p role="status">@csvResult</p>
}
@if (TempData["BulkPunchNotice"] is string notice)
{
    <p class="notice" role="status">@notice</p>
}

<div class="page-workspace" data-page-workspace>
<nav class="workspace-tabs" aria-label="Attendance views">
<a href="#attendance-daily" data-workspace-link>Daily attendance</a>
<a href="#attendance-live" data-workspace-link>Live punches</a>
<a href="#attendance-import" data-workspace-link>Import &amp; manual entry</a>
<a href="#attendance-clock" data-workspace-link>Clock review (@Model.ClockReviews.Count(r => r.ReviewedUtc == null))</a>
<a href="#attendance-review" data-workspace-link>Corrections &amp; device mapping</a>
</nav>
<section id="attendance-daily" data-workspace-panel aria-label="Daily attendance"><section class="card workspace-list">
    <header class="workspace-list-heading"><h2>Daily attendance</h2><small>@Model.Paging.TotalRecords matching records</small></header>
    <form method="get" asp-fragment="attendance-daily" class="attendance-filter-form">
        <label>Employee<select asp-for="EmployeeFilter"><option value="">All employees</option>@foreach(var employee in Model.Employees){<option value="@employee.Id">@employee.EmployeeNumber · @employee.FullName</option>}</select></label>
        <label>From<input asp-for="From" type="date" /></label><label>To<input asp-for="To" type="date" /></label>
        <label>Records per page<select asp-for="RowsPerPage" onchange="this.form.requestSubmit()">@foreach(var size in HrSystemDhg.Web.Services.ListPager.Options){<option value="@size">@size</option>}</select></label>
        <div class="actions"><button class="secondary">Apply filters</button><a asp-page="./Attendance" asp-route-From="@Model.From.ToString("yyyy-MM-dd")" asp-route-To="@Model.To.ToString("yyyy-MM-dd")" asp-route-RowsPerPage="@Model.RowsPerPage" asp-fragment="attendance-daily">Clear employee</a></div>
    </form>
    @if (Model.Items.Count == 0) { <p>No attendance summaries match this employee and date range.</p> }
    else
    {
        <div class="table-scroll">
            <table class="workspace-table">
                <thead><tr><th>Employee</th><th>Date</th><th>Time in (EAT)</th><th>Time out (EAT)</th><th>Worked / required</th><th>Late / early</th><th>Missing minutes</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var day in Model.Items)
                {
                    var tone = day.Status switch { "Present" => "status-positive", "Absent" => "status-negative", "Late" or "Short hours" or "Incomplete punch" => "status-warning", _ => "" };
                    <tr>
                        <th scope="row">@Model.Names.GetValueOrDefault(day.EmployeeId)</th>
                        <td>@day.Date.ToString("dd MMM yyyy")</td>
                        <td>@(day.FirstIn?.ToString("hh:mm tt") ?? "—")</td>
                        <td>@(day.LastOut?.ToString("hh:mm tt") ?? "—")</td>
                        <td>@HrSystemDhg.Web.Pages.Hr.AttendanceModel.HoursAndMinutes(day.WorkedHours) / @HrSystemDhg.Web.Pages.Hr.AttendanceModel.HoursAndMinutes(day.ExpectedHours)</td>
                        <td>@day.LateMinutes / @day.EarlyMinutes min</td><td>@day.MissingMinutes min</td>
                        <td><span class="badge @tone">@day.Status</span>@if(!string.IsNullOrWhiteSpace(day.StatusMessage)){<small class="attendance-status-message">@day.StatusMessage</small>}@if (day.IsCorrected) { <small> · Corrected</small> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <partial name="/Pages/Shared/_ListPager.cshtml" model="@(new HrSystemDhg.Web.Services.ListPagerView(Model.Paging, Model.PageLink))" />
</section>
</section>
<section id="attendance-live" data-workspace-panel aria-label="Live punches"><section class="card" aria-labelledby="today-punches-title">
    <h2 id="today-punches-title">Today’s punches</h2>
    <form method="get" asp-fragment="attendance-live" class="actions"><input type="hidden" name="From" value="@Model.From.ToString("yyyy-MM-dd")"/><input type="hidden" name="To" value="@Model.To.ToString("yyyy-MM-dd")"/><label for="live-employee-filter">Employee<select id="live-employee-filter" name="EmployeeFilter"><option value="">All employees</option>@foreach(var employee in Model.Employees){<option value="@employee.Id" selected="@(Model.EmployeeFilter==employee.Id)">@employee.EmployeeNumber · @employee.FullName</option>}</select></label><button class="secondary">Filter live punches</button></form>
    <p>Latest 200 records for the selected employee today in Mogadishu time. This list refreshes every 15 seconds while the page is visible.</p>
    <div class="table-scroll" id="today-punches" data-refresh-url="@Url.Page("./Attendance", "TodayPunches", new { EmployeeFilter=Model.EmployeeFilter })">
        <partial name="_TodayPunches" model="Model.TodayPunches" />
    </div>
</section>
<script src="~/js/today-punches.js" asp-append-version="true" defer></script>

</section>
<section id="attendance-import" data-workspace-panel aria-label="Import and manual entry"><form method="post" asp-page-handler="Csv" enctype="multipart/form-data" class="card"><h2>CSV punch import</h2><p>Use the sample headers. Times use East Africa Time (UTC+3) unless the timestamp includes a UTC offset. Maximum 2 MB.</p><div class="actions"><a class="button secondary" asp-page-handler="Sample">Download sample CSV</a><a class="button secondary" asp-page-handler="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-EmployeeFilter="@Model.EmployeeFilter">Export punches for selected dates</a></div><label>CSV file<input name="upload" type="file" accept=".csv" required/></label><label>Reason<input name="reason" required/></label><button>Import CSV</button></form>
<p>Import raw local device times or ISO timestamps with UTC offsets. Offset timestamps convert to East Africa Time (EAT, UTC+3). Raw punches are never deleted.</p><div class="grid"><form method="post" asp-page-handler="Punch" class="card"><h2>Manual punch</h2><label>Device<select name="deviceId">@foreach(var d in Model.Devices){<option value="@d.Id">@d.Name</option>}</select></label><label>Employee PIN<input name="pin" required/></label><label>Timestamp<input name="timestamp" value="@HrSystemDhg.Web.Services.BusinessClock.Now.ToString("yyyy-MM-ddTHH:mm:ss")" required/></label><label>Reason<input name="reason" required/></label><button>Import punch</button></form><form method="post" asp-page-handler="PunchAll" class="card">
    <h2>Bulk manual punch</h2>
    <p>Record the current Mogadishu time for every active employee you can manage who has a terminal User ID.</p>
    <label>Device
        <select name="deviceId" required>
            @foreach (var device in Model.Devices)
            {
                <option value="@device.Id">@device.Name</option>
            }
        </select>
    </label>
    <label>Reason<input name="reason" required /></label>
    <button type="submit">Punch all employees now</button>
</form>
</div></section>
<section id="attendance-review" data-workspace-panel aria-label="Corrections and device mapping"><div class="grid"><form method="post" asp-page-handler="Correct" class="card"><h2>Attendance correction</h2><label>Employee<select name="employeeId">@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select></label><label>Work date<input name="date" type="date" required/></label><label>First in<input name="first" type="datetime-local" required/></label><label>Last out<input name="last" type="datetime-local" required/></label><label>Reason<input name="reason" required/></label><button>Save audited correction</button></form><form method="post" asp-page-handler="Overtime" class="card"><h2>Approve overtime</h2><label>Employee<select name="employeeId">@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select></label><label>Work date<input name="date" type="date" required/></label><label>Approved hours<input name="hours" type="number" min="0" max="16" step="0.25" required/></label><label>Reason<input name="reason" required/></label><button>Approve overtime</button></form></div><div class="card"><h2>Unmapped PIN queue</h2><p>Unmapped punches: @Model.Unmapped.Count. Map a PIN to an employee, then rebuild summaries.</p>@foreach(var pin in Model.Unmapped){<form method="post" asp-page-handler="Map" class="inline"><input type="hidden" name="pin" value="@pin"/><strong>@pin</strong><select name="employeeId">@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select><button>Map PIN & rebuild</button></form>}</div><form method="post" asp-page-handler="Rebuild" class="card"><h2>Rebuild attendance summaries</h2><div class="grid"><label>From<input name="from" type="date" required/></label><label>To<input name="to" type="date" required/></label></div><button>Rebuild date range</button></form>
</section><section id="attendance-clock" data-workspace-panel aria-label="Terminal clock review"><section class="card"><h2>Terminal clock exceptions</h2><p>These records were stamped in the future by the terminal. They are preserved separately and excluded from attendance and payroll until HR confirms an actual time. Valid scans continue uploading.</p>
<div class="actions"><a asp-page="./Attendance" asp-route-clockHistory="@(!Model.ClockHistory)" asp-fragment="attendance-clock">@(Model.ClockHistory ? "Show pending only" : "Show review history")</a></div>
@if(Model.ClockReviews.Count == 0){<p>No clock exceptions in this view.</p>}
else { <p>Latest @Model.ClockReviews.Count exceptions shown.</p><div class="table-scroll"><table><thead><tr><th>Employee / PIN</th><th>Device</th><th>Original terminal time (EAT)</th><th>Received (EAT)</th><th>Review</th></tr></thead><tbody>
@foreach(var review in Model.ClockReviews){<tr><td>@(Model.Employees.FirstOrDefault(e => e.ZkPin == review.Pin)?.FullName ?? "Unmapped")<br/>PIN @review.Pin</td><td>@Model.Devices.FirstOrDefault(d=>d.Id==review.DeviceId)?.Name</td><td>@review.RecordedTime.ToString("dd MMM yyyy HH:mm:ss")<br/>@review.Reason</td><td>@HrSystemDhg.Web.Services.OperationsPolicy.Local(review.ReceivedUtc).ToString("dd MMM yyyy HH:mm:ss")</td><td>
@if(review.ReviewedUtc != null){<strong>@review.Resolution</strong><p>@review.CorrectedTime?.ToString("dd MMM yyyy HH:mm:ss") · @review.Reviewer<br/>@review.ReviewReason</p>}
else if(User.IsInRole("Admin") || User.IsInRole("HR")){
<form method="post" asp-page-handler="ReviewClock" asp-route-id="@review.Id"><label>Confirmed actual time (EAT)<input type="datetime-local" name="correctedTime" step="1"/></label><label>Review reason<input name="reason" maxlength="500" required/></label><div class="actions"><button name="resolution" value="correct">Save confirmed time</button><button class="secondary" name="resolution" value="ignore">Ignore invalid punch</button></div></form>
}else{<span>Awaiting HR review</span>}
</td></tr>}
</tbody></table></div>}
</section></section></div>