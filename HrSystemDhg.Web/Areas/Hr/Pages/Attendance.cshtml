@page
@model HrSystemDhg.Web.Pages.Hr.AttendanceModel
@{ViewData["Title"]="Attendance & imports";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Attendance & imports</h1>
<div asp-validation-summary="All"></div><p class="muted">East Africa Time (UTC+3). From 23 November: check-in 6:30–10:30 AM; checkout 11:30 AM–3:30 PM. Saturday–Thursday: 480 worked minutes per day. Missing punches require review.</p>
@if (TempData["RegistrationCsvResult"] is string csvResult)
{
    <p role="status">@csvResult</p>
}
@if (TempData["BulkPunchNotice"] is string notice)
{
    <p class="notice" role="status">@notice</p>
}

<form method="post" asp-page-handler="Csv" enctype="multipart/form-data" class="card"><h2>CSV punch import</h2><p>Use the sample headers. Times use East Africa Time (UTC+3) unless the timestamp includes a UTC offset. Maximum 2 MB.</p><div class="actions"><a class="button secondary" asp-page-handler="Sample">Download sample CSV</a><a class="button secondary" asp-page-handler="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">Export punches for selected dates</a></div><label>CSV file<input name="upload" type="file" accept=".csv" required/></label><label>Reason<input name="reason" required/></label><button>Import CSV</button></form>
<section class="card" aria-labelledby="today-punches-title">
    <h2 id="today-punches-title">Today’s punches</h2>
    <p>Latest 200 records for today in Mogadishu time. This list refreshes every 15 seconds while the page is visible.</p>
    <div class="table-scroll" id="today-punches" data-refresh-url="@Url.Page("./Attendance", "TodayPunches")">
        <partial name="_TodayPunches" model="Model.TodayPunches" />
    </div>
</section>
<script src="~/js/today-punches.js" asp-append-version="true" defer></script>

<p>Import raw local device times or ISO timestamps with UTC offsets. Offset timestamps convert to East Africa Time (EAT, UTC+3). Raw punches are never deleted.</p><div class="grid"><form method="post" asp-page-handler="Punch" class="card"><h2>Manual punch</h2><label>Device<select name="deviceId">@foreach(var d in Model.Devices){<option value="@d.Id">@d.Name</option>}</select></label><label>Employee PIN<input name="pin" required/></label><label>Timestamp<input name="timestamp" value="@HrSystemDhg.Web.Services.BusinessClock.Now.ToString("yyyy-MM-ddTHH:mm:ss")" required/></label><label>Reason<input name="reason" required/></label><button>Import punch</button></form><form method="post" asp-page-handler="PunchAll" class="card">
    <h2>Bulk manual punch</h2>
    <p>Record the current Mogadishu time for every active employee you can manage who has a terminal User ID.</p>
    <label>Device
        <select name="deviceId" required>
            @foreach (var device in Model.Devices)
            {
                <option value="@device.Id">@device.Name</option>
            }
        </select>
    </label>
    <label>Reason<input name="reason" required /></label>
    <button type="submit">Punch all employees now</button>
</form>
</div><section class="card workspace-list">
    <header class="workspace-list-heading"><h2>Daily attendance</h2><small>@Model.Items.Count records shown</small></header>
    <form method="get" class="actions">
        <label>From<input asp-for="From" type="date" /></label>
        <label>To<input asp-for="To" type="date" /></label>
        <button class="secondary">Apply dates</button>
    </form>
    @if (Model.Items.Count == 0) { <p>No attendance summaries for these dates.</p> }
    else
    {
        <div class="table-scroll">
            <table class="workspace-table">
                <thead><tr><th>Employee</th><th>Date</th><th>Time in (EAT)</th><th>Time out (EAT)</th><th>Worked / scheduled</th><th>Late / early</th><th>Missing minutes</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var day in Model.Items)
                {
                    var tone = day.Status switch { "Present" => "status-positive", "Absent" => "status-negative", "Late" or "Short hours" or "Incomplete punch" => "status-warning", _ => "" };
                    <tr>
                        <th scope="row">@Model.Names.GetValueOrDefault(day.EmployeeId)</th>
                        <td>@day.Date.ToString("dd MMM yyyy")</td>
                        <td>@(day.FirstIn?.ToString("hh:mm tt") ?? "—")</td>
                        <td>@(day.LastOut?.ToString("hh:mm tt") ?? "—")</td>
                        <td>@day.WorkedHours.ToString("0.##") / @day.ExpectedHours.ToString("0.##") hrs</td>
                        <td>@day.LateMinutes / @day.EarlyMinutes min</td><td>@day.MissingMinutes min</td>
                        <td><span class="badge @tone">@day.Status</span>@if (day.IsCorrected) { <small> · Corrected</small> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
<div class="grid"><form method="post" asp-page-handler="Correct" class="card"><h2>Attendance correction</h2><label>Employee<select name="employeeId">@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select></label><label>Work date<input name="date" type="date" required/></label><label>First in<input name="first" type="datetime-local" required/></label><label>Last out<input name="last" type="datetime-local" required/></label><label>Reason<input name="reason" required/></label><button>Save audited correction</button></form><form method="post" asp-page-handler="Overtime" class="card"><h2>Approve overtime</h2><label>Employee<select name="employeeId">@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select></label><label>Work date<input name="date" type="date" required/></label><label>Approved hours<input name="hours" type="number" min="0" max="16" step="0.25" required/></label><label>Reason<input name="reason" required/></label><button>Approve overtime</button></form></div><div class="card"><h2>Unmapped PIN queue</h2><p>Unmapped punches: @Model.Unmapped.Count. Map a PIN to an employee, then rebuild summaries.</p>@foreach(var pin in Model.Unmapped){<form method="post" asp-page-handler="Map" class="inline"><input type="hidden" name="pin" value="@pin"/><strong>@pin</strong><select name="employeeId">@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select><button>Map PIN & rebuild</button></form>}</div><form method="post" asp-page-handler="Rebuild" class="card"><h2>Rebuild attendance summaries</h2><div class="grid"><label>From<input name="from" type="date" required/></label><label>To<input name="to" type="date" required/></label></div><button>Rebuild date range</button></form>
