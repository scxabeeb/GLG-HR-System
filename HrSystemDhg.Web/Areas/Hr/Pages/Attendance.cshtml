@page
@model HrSystemDhg.Web.Pages.Hr.AttendanceModel
@{ViewData["Title"]="Attendance & imports";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Attendance & imports</h1>
<div asp-validation-summary="All"></div>
<p>Import raw local device times or ISO timestamps with UTC offsets. Offset timestamps convert to the employee branch timezone. Raw punches are never deleted.</p><div class="grid"><form method="post" asp-page-handler="Punch" class="card"><h2>Manual punch</h2><label>Device<select name="deviceId">@foreach(var d in Model.Devices){<option value="@d.Id">@d.Name</option>}</select></label><label>Employee PIN<input name="pin" required/></label><label>Timestamp<input name="timestamp" placeholder="2026-10-22T08:00:00+03:00" required/></label><label>Reason<input name="reason" required/></label><button>Import punch</button></form><form method="post" asp-page-handler="Csv" enctype="multipart/form-data" class="card"><h2>CSV punch import</h2><p>Header: DeviceId,Pin,Timestamp. One punch per row, UTF-8, maximum 2 MB. Import is atomic.</p><label>CSV file<input name="upload" type="file" accept=".csv" required/></label><label>Reason<input name="reason" required/></label><button>Import CSV</button></form></div><div class="card table-scroll"><h2>Daily summaries</h2><form method="get" class="inline"><label>From<input asp-for="From" type="date"/></label><label>To<input asp-for="To" type="date"/></label><button>Filter</button></form><table><tr><th>Employee</th><th>Date</th><th>In / Out</th><th>Hours</th><th>Late / Early</th><th>Status</th></tr>@foreach(var d in Model.Items){<tr><td>@Model.Names.GetValueOrDefault(d.EmployeeId)</td><td>@d.Date.ToString("dd MMM yyyy")</td><td>@d.FirstIn?.ToString("HH:mm") – @d.LastOut?.ToString("HH:mm")</td><td>@d.WorkedHours.ToString("N2") / @d.ExpectedHours</td><td>@d.LateMinutes / @d.EarlyMinutes min</td><td>@d.Status @(d.IsCorrected?"(corrected)":"")</td></tr>}</table></div><div class="grid"><form method="post" asp-page-handler="Correct" class="card"><h2>Attendance correction</h2><label>Employee<select name="employeeId">@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select></label><label>Work date<input name="date" type="date" required/></label><label>First in<input name="first" type="datetime-local" required/></label><label>Last out<input name="last" type="datetime-local" required/></label><label>Reason<input name="reason" required/></label><button>Save audited correction</button></form><form method="post" asp-page-handler="Overtime" class="card"><h2>Approve overtime</h2><label>Employee<select name="employeeId">@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select></label><label>Work date<input name="date" type="date" required/></label><label>Approved hours<input name="hours" type="number" min="0" max="16" step="0.25" required/></label><label>Reason<input name="reason" required/></label><button>Approve overtime</button></form></div><div class="card"><h2>Unmapped PIN queue</h2><p>Unmapped punches: @Model.Unmapped.Count. Map a PIN to an employee, then rebuild summaries.</p>@foreach(var pin in Model.Unmapped){<form method="post" asp-page-handler="Map" class="inline"><input type="hidden" name="pin" value="@pin"/><strong>@pin</strong><select name="employeeId">@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select><button>Map PIN & rebuild</button></form>}</div><form method="post" asp-page-handler="Rebuild" class="card"><h2>Rebuild attendance summaries</h2><div class="grid"><label>From<input name="from" type="date" required/></label><label>To<input name="to" type="date" required/></label></div><button>Rebuild date range</button></form>