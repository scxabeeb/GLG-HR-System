@page
@model HrSystemDhg.Web.Pages.Hr.SalaryModel
@{ViewData["Title"]="Salary versions";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Salary versions</h1>


<div asp-validation-summary="All"></div>
<p>Salary versions are effective-dated; draft changes stay hidden from employees and payroll.</p><div class="page-workspace" data-page-workspace>
<nav class="workspace-tabs" aria-label="Salary views">
<a href="#salary-history" data-workspace-link>Salary register</a>
<a href="#salary-create" data-workspace-link>Add salary version</a>
<a href="#salary-import" data-workspace-link>Import &amp; export</a>
<a asp-area="" asp-page="/Reports/Index" asp-route-report="Salary">Salary reports</a>
</nav>
<section id="salary-history" data-workspace-panel><div class="card table-scroll"><h2>History</h2><table data-registration-list="Salary-1"><tr><th>Employee</th><th>Effective</th><th>Basic</th><th>Allowances</th><th>Currency</th><th>Status</th></tr>@foreach(var s in Model.Versions){<tr><td>@Model.Employees.FirstOrDefault(e=>e.Id==s.EmployeeId)?.FullName</td><td>@s.EffectiveFrom.ToString("dd MMM yyyy")</td><td>@s.Basic</td><td>@(s.Housing+s.Transport+s.Allowances)</td><td>@s.Currency</td><td>@(s.IsDraft?"Draft":"Published") @if(s.IsDraft){<form method="post" asp-page-handler="Publish"><input type="hidden" name="id" value="@s.Id"/><button>Publish</button></form>}</td></tr>}</table></div>
</section>
<section id="salary-create" data-workspace-panel data-workspace-auto>
<details class="card workspace-tools" open="@(Model.ReturnToWizard || Model.EmployeeId != 0 || !ViewData.ModelState.IsValid)">
<summary>Add salary version</summary>
<p>Choose the employee and effective date, then enter pay, allowances and payment information.</p>
<form method="post" class="workspace-editor"><input type="hidden" asp-for="ReturnToWizard"/><div class="grid"><label>Employee<select asp-for="EmployeeId">@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select></label><label>Basic<input asp-for="Basic" type="number" step="0.01" min="0"/></label><label>Housing<input asp-for="Housing" type="number" step="0.01" min="0"/></label><label>Transport<input asp-for="Transport" type="number" step="0.01" min="0"/></label><label>Other allowance name<input asp-for="OtherName"/></label><label>Other allowance<input asp-for="Allowances" type="number" step="0.01" min="0"/></label><label>Currency<input asp-for="Currency" maxlength="3"/></label><label>Effective from<input asp-for="Effective" type="date"/></label><label>Bank name<input asp-for="Bank"/></label><label>Account name<input asp-for="AccountName"/></label><label>Account number<input asp-for="Account" autocomplete="off"/></label><label class="inline"><input asp-for="Overtime"/> Overtime eligible</label><label class="inline"><input asp-for="Draft"/> Save draft</label></div><button>Add salary version</button></form></details></section>
<section id="salary-import" data-workspace-panel><partial name="/Pages/Shared/_RegistrationCsv.cshtml" model='("salary versions")' /></section></div>
