@page
@model HrSystemDhg.Web.Pages.Identity.Account.ChangePasswordModel
@{ViewData["Title"]="Change password";}
<div class="card login"><h1>Change password</h1><p>Use at least 10 characters with uppercase, lowercase, a number and a symbol.</p><form method="post"><div asp-validation-summary="All"></div><label>Current password<input asp-for="Current" type="password" autocomplete="current-password" required/></label><label>New password<input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="10" required/></label><label>Confirm new password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required/></label><button>Save password</button></form><p><a asp-page="ForgotPassword">Forgot your current password?</a></p></div>
