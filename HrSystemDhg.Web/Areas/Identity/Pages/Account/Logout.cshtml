@page
@model HrSystemDhg.Web.Pages.Identity.Account.LogoutModel
@{ ViewData["Title"] = "Sign out"; }
<div class="card login">
    <h1>Sign out</h1>
    <p>End your Garowe HR session on this device.</p>
    <form method="post" asp-route-mobile="@ViewContext.HttpContext.Request.Query["mobile"]">
        <button>Sign out</button>
    </form>
</div>
