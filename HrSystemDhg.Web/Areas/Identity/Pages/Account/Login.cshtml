@page "/Identity/Account/Login"
@model HrSystemDhg.Web.Pages.Identity.Account.LoginModel
@inject HrSystemDhg.Web.Services.PortalBranding Branding
@{ var brand = await Branding.GetAsync(); }
@{ ViewData["Title"] = "Sign in"; ViewData["AuthPage"] = true; }
<div class="auth-page">
    <section class="auth-story" aria-label="@brand.Name">
        <a class="auth-wordmark" href="/"><img src="@brand.LogoUrl" alt="@brand.Organization"/><span><strong>@brand.ShortName</strong><small>@brand.Subtitle</small></span></a>
        <div class="auth-story-copy"><span class="auth-kicker">OFFICIAL MUNICIPAL WORKSPACE</span><h1>@brand.Name</h1><p>Manage employees, coordinate teams and oversee city resources from one connected workspace.</p>
        <div class="auth-module-grid"><span>People &amp; attendance</span><span>Tasks &amp; teams</span><span>Meetings &amp; decisions</span><span>Payroll &amp; leave</span><span>Assets &amp; equipment</span><span>Fleet &amp; transport</span></div></div>
        <div class="auth-story-footer"><span class="auth-city-mark" aria-hidden="true">G</span><span>@brand.Organization<br/><strong>People · Operations · Resources</strong></span></div>
    </section>
    <div class="auth-form-side">
        <a class="auth-mobile-brand" href="/"><img src="@brand.LogoUrl" alt="@brand.Organization"/><span>@brand.ShortName<small>@brand.Subtitle</small></span></a>
        <article class="auth-card">
            <div class="auth-form-emblem"><img src="@brand.LogoUrl" alt=""/><span>STAFF &amp; ADMINISTRATION PORTAL</span></div><div class="eyebrow">WELCOME BACK</div><h1>Sign in to your workspace</h1><p>Enter your username, email address or employee ID to continue.</p>
            <form method="post">
                <input asp-for="ReturnUrl" type="hidden"/>
                <div asp-validation-summary="All" role="alert"></div>
                <div class="auth-field"><label asp-for="Username">Username, email or employee ID</label><input asp-for="Username" autocomplete="username" placeholder="Your username, email or employee ID" required/></div>
                <div class="auth-field"><label asp-for="Password">Password</label><input asp-for="Password" type="password" autocomplete="current-password" placeholder="Enter your password" required/></div>
                <p class="caps-lock-hint" hidden aria-live="polite">Caps Lock is on.</p><div class="auth-recovery"><a asp-page="ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">Forgot your password?</a></div>
                <button class="auth-submit">Sign in <span aria-hidden="true">→</span></button>
            </form>
            <div class="auth-help"><span class="auth-lock" aria-hidden="true">◈</span><p>Use the account supplied by your administrator.<br/>Contact your administrator if you need access.</p></div>
        </article>
        <p class="auth-copyright">© @HrSystemDhg.Web.Services.BusinessClock.Today.Year @brand.Organization</p>
    </div>
</div>
