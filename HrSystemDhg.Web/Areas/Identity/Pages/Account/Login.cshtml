@page "/Identity/Account/Login"
@model HrSystemDhg.Web.Pages.Identity.Account.LoginModel
<div class="card login"><img class="login-logo" src="~/images/garowe-local-government.jpg" alt="Garowe Local Government emblem"/><div class="eyebrow">GAROWE LOCAL GOVERNMENT</div><h1>Sign in</h1><p>Welcome to your Human Resources workspace.</p><form method="post"><div asp-validation-summary="All"></div><label>Email or employee number<input asp-for="Username" autocomplete="username" required/></label><label>Password<input asp-for="Password" type="password" autocomplete="current-password" required/></label><button>Sign in →</button></form><p><a asp-page="ForgotPassword">Forgot password?</a></p></div>
