@page
@model HrSystemDhg.Web.Pages.Identity.Account.ResetPasswordModel
@{ViewData["Title"]="Choose a new password";}
<div class="card login"><h1>Choose a new password</h1>
@if(Model.Complete){<div role="status"><p>Your password has been reset. Sign in using your new password.</p></div><a class="button" asp-page="Login">Return to sign in</a>}
else if(string.IsNullOrWhiteSpace(Model.Code)||string.IsNullOrWhiteSpace(Model.Email)){<p>A valid reset link is required.</p><a asp-page="ForgotPassword">Request a reset link</a>}
else{<p>Reset password for @Model.Email. Use at least 10 characters with uppercase, lowercase, a number and a symbol.</p><form method="post"><div asp-validation-summary="All"></div><input asp-for="Email" type="hidden"/><input asp-for="Code" type="hidden"/><label asp-for="Password">New password</label><input asp-for="Password" type="password" autocomplete="new-password" required minlength="10"/><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required/><button>Reset password</button></form><p><a asp-page="ForgotPassword">Request another reset link</a></p>}
</div>
