@page
@model HrSystemDhg.Web.Pages.Identity.Account.ForgotPasswordModel
@{ViewData["Title"]="Reset password";}
<div class="card login"><img class="login-logo" src="~/images/garowe-local-government.jpg" alt="Garowe Local Government emblem"/><h1>Reset password</h1>
@if(Model.Submitted){<div role="status"><p>If an enabled account matches that email, a reset link has been sent. The link expires after one hour.</p>@if(Model.LocalDelivery){<p>This local installation saves reset messages privately in <code>App_Data/password-reset-outbox</code>. Your local administrator can retrieve the link.</p>}</div>}
else{<p>Enter your account email to request a reset link.</p><form method="post"><div asp-validation-summary="All"></div><label asp-for="Email">Email address</label><input asp-for="Email" type="email" autocomplete="email" required/><button>Send reset link</button></form>}
<p><a asp-page="Login">Back to sign in</a></p></div>
