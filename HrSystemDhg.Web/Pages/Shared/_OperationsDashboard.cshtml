@model HrSystemDhg.Web.Pages.IndexModel
@using HrSystemDhg.Web.Services
@using System.Globalization
@inject ModuleAccess DashboardPermissions
@inject PortalBranding Branding
@{
    var blocked = await DashboardPermissions.BlockedAsync();
    var brand = await Branding.GetAsync();
    bool Allowed(string menu) => MenuPermissions.Allows(blocked, menu);
    var people = User.IsInRole("Admin") || User.IsInRole("HR");
    var management = User.IsInRole("Admin") || User.IsInRole("Management");
    var coverage = Math.Clamp(Model.AttendancePercent, 0, 100);
    var employeeUrl = people && Allowed("people.directory") ? "/Hr/Employees" : ModuleAccess.Allows(blocked, "reports") && Allowed("people.reports") ? "/Reports?report=Employees" : null;
    var payrollUrl = management && Allowed("payroll.manage") ? "/Management/Payroll" : ModuleAccess.Allows(blocked, "reports") && Allowed("payroll.reports") ? "/Reports?report=Payroll" : null;
    var modules = new List<(string Label,string Detail,string Url,string Icon)>();
    if(people && Allowed("people.directory")){modules.Add(("Employees","Profiles, employment and documents","/Hr/Employees","people"));}
    if(Allowed("tasks.manage")){modules.Add(("Tasks & teams","Assignments, responsibilities and progress","/Operations/Tasks?view=created","tasks"));}
    else if(Allowed("tasks.mine")){modules.Add(("My tasks","Your assignments and progress","/Operations/Tasks","tasks"));}
    if(Allowed("meetings.manage")){modules.Add(("Meetings","Schedules, agendas and decisions","/Operations/Meetings?mode=manage","meetings"));}
    else if(Allowed("meetings.mine")){modules.Add(("My meetings","Upcoming meetings and participation","/Operations/Meetings","meetings"));}
    if(management && Allowed("assets.register")){modules.Add(("Assets","Inventory, custody and condition","/Assets","assets"));}
    if(management && Allowed("fleet.register")){modules.Add(("Fleet","Vehicles, trips and maintenance","/Operations/Fleet","fleet"));}
    if(Allowed("reports.hub")){modules.Add(("Main reports","Filter, review and export your data","/Reports/All","reports"));}
}
<div class="dashboard-workspace" data-no-section-index>
<div class="portal-page-heading"><div><div class="eyebrow">CITY ADMINISTRATION</div><h1>Workspace overview</h1><p>A clear view of your people, work and resources.</p></div><div class="portal-office-date"><span class="date-symbol"><partial name="/Pages/Shared/_WorkspaceIcon.cshtml" model='"meetings"'/></span><span><small>EAST AFRICA TIME · UTC+3</small><strong>@BusinessClock.Today.ToString("dddd, dd MMMM yyyy")</strong></span></div></div>
<section class="dashboard-welcome" aria-label="Workspace introduction"><div><span class="dashboard-welcome-label">@brand.Organization</span><h2>Welcome to your city workspace</h2><p>Review today's attendance, follow up on requests and keep your teams moving.</p><div class="actions">@if(Allowed("attendance.manage")){<a class="button" href="/Hr/Attendance">Today's attendance →</a>}<a class="button secondary" href="/Operations/Notifications">Open inbox</a></div></div><img src="@brand.LogoUrl" alt="@brand.Organization"/></section>
<div class="portal-stat-grid">
@if(employeeUrl != null){<a class="portal-stat" href="@employeeUrl"><span class="stat-caption">Active employees</span><span class="stat-symbol blue-symbol"><partial name="/Pages/Shared/_WorkspaceIcon.cshtml" model='"people"'/></span><strong>@Model.Employees</strong><small>Across your authorized branches <span>→</span></small></a>}
@if(Allowed("leave.requests")){<a class="portal-stat" href="/Hr/Leave"><span class="stat-caption">Leave awaiting action</span><span class="stat-symbol gold-symbol"><partial name="/Pages/Shared/_WorkspaceIcon.cshtml" model='"leave"'/></span><strong>@Model.Leave</strong><small>Open requests for review <span>→</span></small></a>}
@if(Allowed("attendance.manage")){<a class="portal-stat" href="/Hr/Attendance"><span class="stat-caption">Attendance today</span><span class="stat-symbol green-symbol"><partial name="/Pages/Shared/_WorkspaceIcon.cshtml" model='"attendance"'/></span><strong>@coverage.ToString("N0")<em>%</em></strong><small>@Model.Present of @Model.Expected expected employees covered <span>→</span></small></a>}
@if(User.IsInRole("Admin")){<a class="portal-stat" href="/Admin/Organization"><span class="stat-caption">Active branches</span><span class="stat-symbol violet-symbol"><partial name="/Pages/Shared/_WorkspaceIcon.cshtml" model='"branches"'/></span><strong>@Model.Branches</strong><small>Manage connected workplaces <span>→</span></small></a>}
</div>
<div class="portal-dashboard-grid">
@if(employeeUrl != null){
<article class="card portal-headcount"><div class="panel-heading"><div><h2>People across branches</h2><p>Current employee assignments</p></div><a href="@employeeUrl">View employees →</a></div>
@if(Model.Headcount.Count == 0){<div class="portal-empty"><strong>No employee assignments yet</strong><p>Register employees and assign them to a branch to see your workforce distribution.</p></div>}
@foreach(var branch in Model.Headcount.OrderByDescending(x=>x.Value)){<div class="portal-branch-row"><div><span>@branch.Key</span><strong>@branch.Value <small>employees</small></strong></div><progress max="@Math.Max(1,Model.Employees)" value="@branch.Value" aria-label="@($"{branch.Key}: {branch.Value} employees")"></progress></div>}
</article>}
@if(Allowed("attendance.manage")){
<article class="card portal-coverage"><div class="panel-heading"><div><h2>Today's attendance</h2><p>Attendance and approved leave coverage</p></div></div><div class="portal-donut" style="--coverage:@coverage.ToString("0.##", CultureInfo.InvariantCulture)" role="img" aria-label="@($"{coverage:N0}% attendance coverage")"><div><strong>@coverage.ToString("N0")<small>%</small></strong><span>coverage today</span></div></div><div class="coverage-legend"><span><i></i> @Model.Present covered</span><span><i></i> @Math.Max(0,Model.Expected-Model.Present) remaining</span></div><a class="button secondary" href="/Hr/Attendance">Review attendance →</a></article>}
@if(payrollUrl != null){
<article class="card portal-payroll"><div class="panel-heading"><div><h2>Latest payroll</h2><p>Net payable by currency</p></div><span class="panel-tag">FINANCE</span></div>@if(Model.Costs.Count==0){<div class="portal-empty"><strong>No calculated payroll yet</strong><p>Generate and calculate a payroll run to review its totals here.</p></div>}@foreach(var total in Model.Costs){<div class="portal-payroll-amount"><span>@total.Key</span><strong>@total.Value.ToString("N2")</strong><small>Net payable · latest calculated run</small></div>}<a class="button secondary" href="@payrollUrl">View payroll →</a></article>}
</div>
<div class="portal-section-heading"><div><h2>Explore your modules</h2><p>Open a workspace to manage records, track progress or review reports.</p></div></div>
<div class="portal-module-grid">
@foreach(var module in modules){<a class="portal-module" href="@module.Url"><span class="module-glyph"><partial name="/Pages/Shared/_WorkspaceIcon.cshtml" model="module.Icon"/></span><span><strong>@module.Label</strong><small>@module.Detail</small></span><b aria-hidden="true">→</b></a>}
</div>
</div>
