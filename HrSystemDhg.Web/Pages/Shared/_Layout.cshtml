<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Garowe HR</title><link rel="icon" type="image/jpeg" href="~/images/garowe-local-government.jpg"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><button class="nav-scrim" aria-label="Close navigation" onclick="toggleNavigation()"></button><aside id="workspace-nav"><a class="brand" href="/" aria-label="Garowe Local Government HR home"><img class="brand-logo" src="~/images/garowe-local-government.jpg" alt="Garowe Local Government emblem"/><span class="brand-name">GAROWE</span><span class="brand-subtitle">LOCAL GOVERNMENT</span></a><div class="nav-tools"><span>YOUR WORKSPACE</span><button type="button" id="expand-menus">Expand all</button></div><nav aria-label="Main navigation">
<details class="nav-group" data-menu="workspace"><summary><span class="nav-icon" aria-hidden="true">⌂</span>Workspace</summary><a href="/">Overview</a><a href="/Me/Profile">My workspace</a><a href="/Me/Approvals">Team approvals</a></details>
@if(User.IsInRole("HR")||User.IsInRole("Admin")||User.IsInRole("Management")){
<details class="nav-group" data-menu="people"><summary><span class="nav-icon" aria-hidden="true">♙</span>People & attendance</summary>
@if(User.IsInRole("HR")||User.IsInRole("Admin")){<a href="/Hr/Employees">Employees</a><a href="/Hr/Salary">Salary registration</a>}
<a href="/Hr/Attendance">Attendance & imports</a><a href="/Hr/Leave">Leave requests</a><a href="/Hr/Corrections">Attendance corrections</a></details>
<details class="nav-group" data-menu="finance"><summary><span class="nav-icon" aria-hidden="true">▥</span>Finance & reporting</summary>
@if(User.IsInRole("Management")||User.IsInRole("Admin")){<a href="/Management/Payroll">Payroll</a>}<a href="/Reports/Index">Reports & exports</a></details>}
@if(User.IsInRole("Admin")){
<details class="nav-group" data-menu="admin"><summary><span class="nav-icon" aria-hidden="true">⚙</span>Administration</summary><a href="/Admin/Settings">System settings</a><a href="/Admin/Users">Users & permissions</a><a href="/Admin/Organization">Organization structure</a><a href="/Admin/LeaveTypes">Leave types</a><a href="/Admin/Rules">Hours & deductions</a><a href="/Admin/Devices">Attendance devices</a></details>
<details class="nav-group" data-menu="security"><summary><span class="nav-icon" aria-hidden="true">◇</span>Security & support</summary><a href="/Admin/Audit">Audit log</a><a href="/Admin/Support">Support view</a><a href="/Admin/PasswordResets">Password reset requests</a></details>}
</nav><footer>GAROWE LOCAL GOVERNMENT<br/>Human Resources Management</footer></aside><main><header><button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-controls="workspace-nav" aria-expanded="false" onclick="toggleNavigation()">☰</button><span>GAROWE / HUMAN RESOURCES</span><div>@User.Identity?.Name @if(User.Identity?.IsAuthenticated==true){<form method="post" action="/Identity/Account/Logout">@Html.AntiForgeryToken()<button>Sign out</button></form>}</div></header><section>@if(User.HasClaim(c=>c.Type=="support-admin")){<div class="card"><strong>Read-only support session</strong><form method="post" action="/Identity/Account/EndSupport">@Html.AntiForgeryToken()<button>Return to Admin</button></form></div>}@RenderBody()</section></main><script src="~/js/navigation.js" asp-append-version="true" defer></script><script src="~/js/password-visibility.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>