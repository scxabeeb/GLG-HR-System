@inject HrSystemDhg.Web.Data.HrDbContext OperationsDb
@using Microsoft.EntityFrameworkCore
@using HrSystemDhg.Web.Services
@inject ModuleAccess ModulePermissions
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var portalRole = User.IsInRole("Admin") ? "Administrator" : User.IsInRole("Management") ? "Management" : User.IsInRole("HR") ? "Human resources" : "Employee workspace";
    var operationsActor = OperationsDb.ActorId;
    var isErrorPage = ViewContext.HttpContext.Request.Path.StartsWithSegments("/Error");
    var hiddenModules = isErrorPage ? new HashSet<string>() : await ModulePermissions.BlockedAsync();
    bool Show(string module) => ModuleAccess.Allows(hiddenModules, module);
    var isAdmin = User.IsInRole("Admin");
    var isHr = User.IsInRole("HR") || isAdmin;
    var isManager = User.IsInRole("Management") || isAdmin;
    var staff = OperationsDb.IsStaff;
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var page = ViewContext.RouteData.Values["page"]?.ToString();
    var adminDetail = isAdmin && area == "Admin" && page is not ("/Settings" or "/Dashboard");
    var hrReports = staff && Show("reports");
    var showTasks = Show("tasks");
    var showMeetings = Show("meetings");
    var showFleet = Show("fleet");
    var unreadOperations = operationsActor == null || isErrorPage ? 0 : await OperationsNotices.Visible(
        OperationsDb.OperationsNotifications.Where(n => n.RecipientId == operationsActor && n.ReadUtc == null), hiddenModules).CountAsync();
}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Garowe HR</title><link rel="icon" type="image/jpeg" href="~/images/garowe-local-government.jpg"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/civic.css" asp-append-version="true"/></head><body class="civic-shell @(signedIn ? "" : "civic-public")"><a class="skip-link" href="#main-content">Skip to main content</a><button class="nav-scrim" aria-label="Close navigation" onclick="toggleNavigation()"></button><aside id="workspace-nav"><a class="brand" href="/" aria-label="Garowe Local Government HR home"><img class="brand-logo" src="~/images/garowe-local-government.jpg" alt="Garowe Local Government emblem"/><span class="brand-copy"><span class="brand-name">Garowe</span><span class="brand-subtitle">Local Government</span></span></a><div class="nav-tools"><span>YOUR WORKSPACE</span><button type="button" id="expand-menus">Expand all</button></div><nav aria-label="Main navigation">
@if (signedIn)
{
    <details class="nav-group" data-menu="workspace">
        <summary><span class="nav-icon" aria-hidden="true">⌂</span>Workspace</summary>
        <a href="/" data-route-prefix="/Admin/Dashboard /Hr/Dashboard /Management/Dashboard">Overview</a>
        @if (Show("personal"))
        {
            <a href="/Me/Profile">My workspace</a>
            <a href="/Me/Agenda">My agenda</a>
        }
    </details>
    @if ((isHr && Show("people")) || ((User.IsInRole("General Secretary")) && Show("leave")) || (staff && (Show("attendance") || Show("leave") || (Show("payroll") && (isHr || isManager || hrReports)))))
    {
        <details class="nav-group" data-menu="hr">
            <summary><span class="nav-icon" aria-hidden="true">♙</span>HR</summary>
            @if (isHr && Show("people"))
            {
                <details class="nav-subgroup" data-menu="people">
                    <summary>Employees</summary>
                    <a href="/Hr/Employees" data-route-prefix="/Hr/Details /Hr/Employment /Hr/Onboarding /Hr/HistoryEdit">Employee directory</a>
                    <a href="/Hr/Register">Register employee</a>
                    @if (hrReports) { <a href="/Reports?report=Employees">Employee reports</a> }
                    @if (isAdmin) { <a href="/Admin/Organization" data-route-prefix="/Admin/OrgEdit">Organization structure</a> }
                </details>
            }
            @if (staff && Show("attendance"))
            {
                <details class="nav-subgroup" data-menu="attendance">
                    <summary>Attendance</summary>
                    <a href="/Hr/Attendance">Attendance &amp; imports</a>
                    <a href="/Hr/Corrections">Corrections</a>
                    @if (hrReports) { <a href="/Reports?report=Attendance">Attendance reports</a> }
                    @if (isAdmin) { <a href="/Admin/Devices">Attendance devices</a> }
                </details>
            }
            @if ((staff || User.IsInRole("General Secretary")) && Show("leave"))
            {
                <details class="nav-subgroup" data-menu="leave">
                    <summary>Leave</summary>
                    <a href="/Hr/Leave">Leave requests</a>
                    @if (isHr) { <a href="/Hr/Balances">Leave balances</a> }
                    @if (hrReports) { <a href="/Reports?report=Leave">Leave reports</a> }
                    @if (isAdmin) { <a href="/Admin/LeaveTypes">Leave policies</a> }
                </details>
            }
            @if (isHr && Show("payroll"))
            {
                <details class="nav-subgroup" data-menu="salary">
                    <summary>Salary</summary>
                    <a href="/Hr/Salary">Salary registration</a>
                    @if (hrReports) { <a href="/Reports?report=Salary">Salary reports</a> }
                </details>
            }
            @if (staff && Show("payroll") && (isManager || hrReports))
            {
                <details class="nav-subgroup" data-menu="finance">
                    <summary>Payroll</summary>
                    @if (isManager) { <a href="/Management/Payroll">Manage payroll</a> }
                    @if (hrReports) { <a href="/Reports?report=Payroll">Payroll reports</a> }
                    @if (isAdmin) { <a href="/Admin/Rules">Hours &amp; deductions</a> }
                </details>
            }
        </details>
    }
    @if (showTasks)
    {
        <details class="nav-group" data-menu="tasks">
            <summary><span class="nav-icon" aria-hidden="true">✓</span>Tasks</summary>
            <a asp-page="/Operations/Tasks" asp-area="" asp-route-view="mine">My tasks</a>
            <a asp-page="/Operations/Tasks" asp-area="" asp-route-view="created">Manage tasks</a>
            <a asp-page="/Operations/TaskReport" asp-area="">Task progress report</a>
        </details>
    }
    @if (showMeetings)
    {
        <details class="nav-group" data-menu="meetings">
            <summary><span class="nav-icon" aria-hidden="true">◈</span>Meetings</summary>
            <a asp-page="/Operations/Meetings" asp-area="" data-route-prefix="/Operations/MeetingDetails">My meetings</a>
            @if (staff) { <a asp-page="/Operations/Meetings" asp-area="" asp-route-mode="manage">Manage meetings</a> }
            <a asp-page="/Operations/MeetingReport" asp-area="">Meeting reports</a>
            <a asp-page="/Operations/MeetingRecordings" asp-area="">Saved recordings</a>
        </details>
    }
    @if (staff && Show("assets"))
    {
        <details class="nav-group" data-menu="assets">
            <summary><span class="nav-icon" aria-hidden="true">▣</span>Assets</summary>
            <a asp-page="/Assets/Index" asp-area="">Asset register</a>
            <a asp-page="/Assets/Edit" asp-area="">Register an asset</a>
            <a asp-page="/Assets/Index" asp-area="" asp-route-report="true">Asset reports</a>
        </details>
    }
    @if (showFleet)
    {
        <details class="nav-group" data-menu="fleet">
            <summary><span class="nav-icon" aria-hidden="true">▰</span>Fleet</summary>
            <a asp-page="/Operations/FleetTrips" asp-area="">Fleet trips</a>
            @if (isManager)
            {
                <a asp-page="/Operations/Fleet" asp-area="">Vehicle register</a>
                <a asp-page="/Operations/FleetReport" asp-area="">Fleet reports &amp; expenses</a>
            }
        </details>
    }
    <div class="nav-hubs">
        <a asp-page="/Reports/Hub" asp-area="" data-route-prefix="/Reports">Main reports</a>
        @if (isAdmin)
        {
            <a asp-page="/Settings" asp-area="Admin" data-route-prefix="/Admin" data-route-exclude="/Admin/Dashboard">Main settings</a>
        }
    </div>
}
</nav><footer><span class="civic-footer-line"></span>GAROWE LOCAL GOVERNMENT<br/>Human Resources &amp; Administration</footer></aside>
<main id="main-content" tabindex="-1">
<header class="civic-topbar">
    <div class="civic-masthead">
        <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-controls="workspace-nav" aria-expanded="false" onclick="toggleNavigation()">☰</button>
        @if (!signedIn) { <img class="civic-public-seal" src="~/images/garowe-local-government.jpg" alt="Garowe Local Government seal" /> }
        <div class="civic-masthead-title"><span>Garowe Local Government</span><strong>Human Resources &amp; Operations</strong></div>
    </div>
    @if (signedIn) {
        <div class="civic-account">
            <span class="civic-account-details"><strong>@User.Identity?.Name</strong><small>@portalRole</small></span>
            <a asp-page="/Operations/Notifications" asp-area="" class="ops-header-inbox"
               data-unread-url="@Url.Page("/Operations/Notifications", "Unread", new { area = "" })">Inbox
                <span class="badge" hidden="@(unreadOperations == 0)" aria-live="polite" aria-label="@($"{unreadOperations} unread notifications")">@unreadOperations</span>
            </a>
            <form method="post" action="/Identity/Account/Logout">@Html.AntiForgeryToken()<button class="secondary">Sign out</button></form>
        </div>
    }
</header>
<section class="civic-content">@if(User.HasClaim(c=>c.Type=="support-admin")){<div class="card"><strong>Read-only support session</strong><form method="post" action="/Identity/Account/EndSupport">@Html.AntiForgeryToken()<button>Return to Admin</button></form></div>}@if (adminDetail)
{
    <a class="hub-back" asp-area="Admin" asp-page="/Settings">← Main settings</a>
}
@RenderBody()</section></main><script src="~/js/navigation.js" asp-append-version="true" defer></script><script src="~/js/inbox.js" asp-append-version="true" defer></script><script src="~/js/password-visibility.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>