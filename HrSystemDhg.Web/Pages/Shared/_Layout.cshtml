@inject HrSystemDhg.Web.Data.HrDbContext OperationsDb
@using Microsoft.EntityFrameworkCore
@using HrSystemDhg.Web.Services
@inject PortalBranding Branding
@inject ModuleAccess ModulePermissions
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var portalRole = User.IsInRole("Admin") ? "Administrator" : User.IsInRole("Management") ? "Management" : User.IsInRole("HR") ? "Human resources" : User.IsInRole("Finance") ? "Finance" : User.IsInRole("General Secretary") ? "General Secretary" : "Employee workspace";
    var operationsActor = OperationsDb.ActorId;
    var isErrorPage = ViewContext.HttpContext.Request.Path.StartsWithSegments("/Error");
    var brand = isErrorPage ? new PortalBranding.Brand("Garowe City Management System", "Garowe City", "Management System", "Garowe Local Government", "/images/garowe-local-government.jpg") : await Branding.GetAsync();
    var hiddenModules = isErrorPage ? new HashSet<string>() : await ModulePermissions.BlockedAsync();
    bool Show(string module) => ModuleAccess.Allows(hiddenModules, module) && (!MenuPermissions.Items.Any(x=>x.Module==module) || MenuPermissions.Items.Any(x=>x.Module==module && !hiddenModules.Contains(x.Key)));
    var isAdmin = User.IsInRole("Admin");
    var isHr = User.IsInRole("HR") || isAdmin;
    var isManager = User.IsInRole("Management") || isAdmin;
    var staff = OperationsDb.IsStaff;
    var payrollAccess = staff || User.IsInRole("Finance") || User.IsInRole("General Secretary");
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var page = ViewContext.RouteData.Values["page"]?.ToString();
    var adminDetail = isAdmin && area == "Admin" && page is not ("/Settings" or "/Dashboard");
    var hrReports = staff && Show("reports");
    var showTasks = Show("tasks");
    var showMeetings = Show("meetings");
    var showFleet = Show("fleet");
    var unreadOperations = operationsActor == null || isErrorPage ? 0 : await OperationsNotices.Visible(
        OperationsDb.OperationsNotifications.Where(n => n.RecipientId == operationsActor && n.ReadUtc == null), hiddenModules).CountAsync();
}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · @brand.Name</title><link rel="icon" href="@brand.LogoUrl"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/civic.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/portal.css" asp-append-version="true"/></head><body class="civic-shell @(signedIn ? "" : "civic-public") @(ViewData["AuthPage"] is true ? "civic-auth" : "")"><a class="skip-link" href="#main-content">Skip to main content</a><button class="nav-scrim" aria-label="Close navigation" onclick="toggleNavigation()"></button><aside id="workspace-nav"><a class="brand" href="/" aria-label="@(brand.Name + " home")"><img class="brand-logo" src="@brand.LogoUrl" alt="@brand.Organization"/><span class="brand-copy"><span class="brand-name">@brand.ShortName</span><span class="brand-subtitle">@brand.Subtitle</span></span></a><div class="nav-tools"><span>YOUR WORKSPACE</span><button type="button" id="expand-menus">Expand all</button></div><label class="nav-search"><span class="sr-only">Find a menu</span><input type="search" id="nav-search" placeholder="Find a menu…" autocomplete="off"/></label><p id="nav-no-results" hidden>No matching menus</p><nav aria-label="Main navigation">
@if (signedIn)
{
    <details class="nav-group" data-menu="workspace">
        <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg></span>Workspace</summary>
        <a href="/" data-route-prefix="/Admin/Dashboard /Hr/Dashboard /Management/Dashboard">Overview</a>
        @if (Show("personal"))
        {
            <a href="/Me/Profile">My workspace</a>
            <a href="/Me/Agenda">My agenda</a>
        }
    </details>
    @if ((payrollAccess && Show("payroll")) || (isHr && Show("people")) || ((User.IsInRole("General Secretary")) && Show("leave")) || (staff && (Show("attendance") || Show("leave") || (Show("payroll") && (isHr || isManager || hrReports)))))
    {
        <details class="nav-group" data-menu="hr">
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="7" r="4"/><path d="M2 21v-3a7 7 0 0 1 14 0v3M17 3a4 4 0 0 1 0 8m3 10v-3a7 7 0 0 0-3-5"/></svg></span>HR</summary>
            @if (isHr && Show("people"))
            {
                <details class="nav-subgroup" data-menu="people">
                    <summary>Employees</summary>
                    <a href="/Hr/Employees" data-route-prefix="/Hr/Details /Hr/Employment /Hr/Onboarding /Hr/HistoryEdit">Employee directory</a>
                    <a href="/Hr/Register">Register employee</a>
                    @if (hrReports) { <a href="/Reports?report=Employees">Employee reports</a> }
                    @if (isAdmin) { <a href="/Admin/Organization" data-route-prefix="/Admin/OrgEdit">Organization structure</a> }
                </details>
            }
            @if (staff && Show("attendance"))
            {
                <details class="nav-subgroup" data-menu="attendance">
                    <summary>Attendance</summary>
                    <a href="/Hr/Attendance">Attendance &amp; imports</a>
                    <a href="/Hr/Corrections">Corrections</a>
                    @if (hrReports) { <a href="/Reports?report=Attendance">Attendance reports</a> }
                    @if (isAdmin) { <a href="/Admin/Devices">Attendance devices</a> }
                </details>
            }
            @if ((staff || User.IsInRole("General Secretary")) && Show("leave"))
            {
                <details class="nav-subgroup" data-menu="leave">
                    <summary>Leave</summary>
                    <a href="/Hr/Leave">Leave requests</a>
                    @if (isHr) { <a href="/Hr/Balances">Leave balances</a> }
                    @if (hrReports) { <a href="/Reports?report=Leave">Leave reports</a> }
                    @if (isAdmin) { <a href="/Admin/LeaveTypes">Leave policies</a> }
                </details>
            }
            @if (isHr && Show("payroll"))
            {
                <details class="nav-subgroup" data-menu="salary">
                    <summary>Salary</summary>
                    <a href="/Hr/Salary">Salary registration</a>
                    @if (hrReports) { <a href="/Reports?report=Salary">Salary reports</a> }
                </details>
            }
            @if (payrollAccess && Show("payroll"))
            {
                <details class="nav-subgroup" data-menu="finance">
                    <summary>Payroll</summary>
                    @if (payrollAccess) { <a href="/Management/Payroll">Manage payroll</a> }
                    @if (hrReports) { <a href="/Reports?report=Payroll">Payroll reports</a> }
                    @if (isAdmin) { <a href="/Admin/Rules">Attendance &amp; payroll rules</a> }
                </details>
            }
        </details>
    }
    @if (showTasks)
    {
        <details class="nav-group" data-menu="tasks">
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="m8 12 3 3 5-6"/></svg></span>Tasks</summary>
            <a asp-page="/Operations/Tasks" asp-area="" asp-route-view="mine">My tasks</a>
            <a asp-page="/Operations/Tasks" asp-area="" asp-route-view="created">Manage tasks</a>
            <a asp-page="/Operations/TaskReport" asp-area="">Task progress report</a>
        </details>
    }
    @if (showMeetings)
    {
        <details class="nav-group" data-menu="meetings">
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 11h18m-11 4h2m3 0h2"/></svg></span>Meetings</summary>
            <a asp-page="/Operations/Meetings" asp-area="" data-route-prefix="/Operations/MeetingDetails">My meetings</a>
            @if (staff) { <a asp-page="/Operations/Meetings" asp-area="" asp-route-mode="manage">Manage meetings</a> }
            <a asp-page="/Operations/MeetingReport" asp-area="">Meeting reports</a>
            <a asp-page="/Operations/MeetingRecordings" asp-area="">Saved recordings</a>
        </details>
    }
    @if (staff && Show("assets"))
    {
        <details class="nav-group" data-menu="assets">
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 11h18m-11 4h2m3 0h2"/></svg></span>Assets</summary>
            <a asp-page="/Assets/Index" asp-area="">Asset register</a>
            <a asp-page="/Assets/Edit" asp-area="">Register an asset</a>
            <a asp-page="/Assets/Index" asp-area="" asp-route-report="true">Asset reports</a>
        </details>
    }
    @if (showFleet)
    {
        <details class="nav-group" data-menu="fleet">
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 5-3 7v7h3v-3h14v3h3v-7l-3-7zM2 12h20M6 13v2m12-2v2"/></svg></span>Fleet</summary>
            <a asp-page="/Operations/FleetTrips" asp-area="">Fleet trips</a>
            @if (isManager)
            {
                <a asp-page="/Operations/Fleet" asp-area="">Vehicle register</a>
                <a asp-page="/Operations/FleetReport" asp-area="">Fleet reports &amp; expenses</a>
            }
        </details>
    }
    <div class="nav-hubs">
        <a asp-page="/Reports/Hub" asp-area="" data-route-prefix="/Reports">Main reports</a>
        @if (isAdmin)
        {
            <a asp-page="/Settings" asp-area="Admin" data-route-prefix="/Admin" data-route-exclude="/Admin/Dashboard">Main settings</a>
        }
    </div>
}
</nav><footer><span class="civic-footer-line"></span>@brand.Organization<br/>@brand.Name</footer></aside>
<main id="main-content" tabindex="-1">
<header class="civic-topbar">
    <div class="civic-masthead">
        <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-controls="workspace-nav" aria-expanded="false" onclick="toggleNavigation()"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        @if (!signedIn) { <img class="civic-public-seal" src="@brand.LogoUrl" alt="Garowe Local Government seal" /> }
        <div class="civic-masthead-title"><span>@(signedIn ? "YOUR WORKSPACE" : brand.Organization)</span><strong>@(signedIn ? ViewData["Title"] : brand.Name)</strong></div>
    </div>
    @if (signedIn) {
        <div class="civic-account">
            <span class="account-avatar" aria-hidden="true">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "G")</span><span class="civic-account-details"><strong>@User.Identity?.Name</strong><small>@portalRole</small></span>
            <a asp-page="/Operations/Notifications" asp-area="" class="ops-header-inbox" aria-label="Inbox and notifications"
               data-unread-url="@Url.Page("/Operations/Notifications", "Unread", new { area = "" })"><span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></span><span class="inbox-caption">Inbox</span>
                <span class="badge" hidden="@(unreadOperations == 0)" aria-live="polite" aria-label="@($"{unreadOperations} unread notifications")">@unreadOperations</span>
            </a>
            <form method="post" action="/Identity/Account/Logout">@Html.AntiForgeryToken()<button class="secondary">Sign out</button></form>
        </div>
    }
</header>
<section class="civic-content">@if(User.HasClaim(c=>c.Type=="support-admin")){<div class="card"><strong>Read-only support session</strong><form method="post" action="/Identity/Account/EndSupport">@Html.AntiForgeryToken()<button>Return to Admin</button></form></div>}@if (adminDetail)
{
    <a class="hub-back" asp-area="Admin" asp-page="/Settings">← Main settings</a>
}
@RenderBody()</section></main><script src="~/js/workspace.js" asp-append-version="true" defer></script><script src="~/js/navigation.js" asp-append-version="true" defer></script><script src="~/js/inbox.js" asp-append-version="true" defer></script><script src="~/js/password-visibility.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>