@page
@model HrSystemDhg.Web.Pages.Reports.IndexModel
@using HrSystemDhg.Web.Services
@inject ModuleAccess ReportAccess
@{
    ViewData["Title"] = "Reports & exports";
    (string Key, string Label)[] reports = [
        ("Employees", "Employees"), ("Attendance", "Attendance"), ("Salary", "Salary"),
        ("Payroll", "Payroll"), ("Hires", "Hires and leavers"), ("Leave", "Leave register"),
        ("Balances", "Leave balances"), ("Deductions", "Deductions"), ("Bank", "Bank payments")
    ];
    var deniedMenus = await ReportAccess.BlockedAsync();
    var title = Model.SavedViewName ?? reports.FirstOrDefault(r => r.Key == Model.Report).Label ?? "Report";
}
<div class="eyebrow">CITY REPORTING WORKSPACE</div>
<a class="hub-back" asp-page="./Hub">← Main reports</a>
<h1>@(Model.SavedViewName ?? "Reports & exports")</h1>
<p class="page-intro">Select a report, set your filters and export the results in your preferred format.</p>
<nav class="actions report-switcher" aria-label="Reports">
    @foreach (var report in reports)
    {
        if (!MenuPermissions.Allows(deniedMenus, MenuPermissions.Report(report.Key)) || report.Key == "Salary" && !Model.CanViewSalary) { continue; }
        var active = Model.Report == report.Key;
        <a class="button @(active ? "" : "secondary")" aria-current="@(active ? "page" : null)"
           asp-page="./Index" asp-route-report="@report.Key">@report.Label</a>
    }
</nav>

@if (TempData["Message"] is string message)
{
    <p role="status">@message</p>
}

<form method="get" class="card report-filter-panel">
    <h2>@title filters</h2>
    <div asp-validation-summary="All"></div>
    <input type="hidden" name="Report" value="@Model.Report" />
    <input asp-for="SavedViewId" type="hidden"/><input type="hidden" name="FiltersApplied" value="true"/>
    <div class="grid">
        @if (Model.UsesDates)
        {
            <label>From<input asp-for="From" type="date" required /></label>
            <label>To<input asp-for="To" type="date" required /></label>
        }
        @if (Model.IsPayrollReport)
        {
            <label>Payroll period
                <select asp-for="PeriodId" required>
                    <option value="">Select a period</option>
                    @foreach (var period in Model.Periods)
                    {
                        <option value="@period.Id">@period.From.ToString("dd MMM yyyy") – @period.To.ToString("dd MMM yyyy") · @period.Status</option>
                    }
                </select>
            </label>
        }
        <label>Employee
            <select asp-for="EmployeeId">
                <option value="">All employees</option>
                @foreach (var employee in Model.Employees)
                {
                    <option value="@employee.Id">@employee.FullName · @employee.EmployeeNumber</option>
                }
            </select>
        </label>
        <label>Branch
            <select asp-for="BranchId">
                <option value="">All branches</option>
                @foreach (var branch in Model.Branches) { <option value="@branch.Id">@branch.Name</option> }
            </select>
        </label>
        <label>Department
            <select asp-for="DepartmentId">
                <option value="">All departments</option>
                @foreach (var department in Model.Departments) { <option value="@department.Id">@department.Name</option> }
            </select>
        </label>
        <label>Sub-department
            <select asp-for="SubDepartmentId">
                <option value="">All sub-departments</option>
                @foreach (var department in Model.SubDepartments) { <option value="@department.Id">@department.Name</option> }
            </select>
        </label>
        @if (Model.Statuses.Count > 0 || Model.Status != null)
        {
            <label>Status
                <select asp-for="Status">
                    <option value="">All statuses</option>
                    @foreach (var status in Model.Statuses.Append(Model.Status).OfType<string>().Distinct())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </label>
        }
    </div>
    <div class="actions">
        <button>Apply filters</button>
        <a class="button secondary" asp-page="./Index" asp-route-report="@Model.Report" asp-route-savedViewId="@Model.SavedViewId">Clear filters</a>
        @if (Model.Rows.Count > 1)
        {
            <button class="secondary" name="format" value="csv">Download CSV</button>
            <button class="secondary" name="format" value="excel">Download Excel</button>
            <button class="secondary" name="format" value="pdf">Download PDF</button>
        }
    </div>
</form>

@if (Model.IsPayrollReport && Model.CanPublish &&
    Model.Periods.Any(p => p.Id == Model.PeriodId && p.Status is "Locked" or "Paid"))
{
    <form method="post" asp-page-handler="Publish" class="actions">
        <input type="hidden" name="id" value="@Model.PeriodId" />
        <button class="secondary">Publish locked payslips</button>
    </form>
}

<section class="card table-scroll report-results" aria-label="@title results">
    <h2>@title</h2>
    @if (Model.IsPayrollReport && Model.PeriodId == null)
    {
        <p>Select a payroll period and apply filters to view this report.</p>
    }
    else if (Model.Rows.Count <= 1)
    {
        <p>No records match these filters.</p>
    }
    else
    {
        <p>@(Model.Rows.Count - 1) records</p>
        <table>
            <thead>
                <tr>@foreach (var cell in Model.Rows[0]) { <th scope="col">@cell</th> }</tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows.Skip(1))
                {
                    <tr>@foreach (var cell in row) { <td>@cell</td> }</tr>
                }
            </tbody>
        </table>
    }
</section>
