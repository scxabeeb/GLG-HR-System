@page
@model HrSystemDhg.Web.Pages.Reports.IndexModel
@{ViewData["Title"]="Reports & exports";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Reports & exports</h1>
<div asp-validation-summary="All"></div>
<p>@TempData["Message"]</p>@if(Model.PeriodId!=null){<form method="post" asp-page-handler="Publish"><input type="hidden" name="id" value="@Model.PeriodId"/><button>Publish locked payslips</button></form>}<p>Filter by organization and date. Export the selected report as CSV or Excel (.xlsx), or print to PDF.</p><form method="get" class="card"><div class="grid"><label>Report<select asp-for="Report"><option value="Employees">Employees</option><option value="Hires">New hires / leavers</option><option value="Attendance">Attendance</option><option value="Leave">Leave register</option><option value="Balances">Leave balances</option><option value="Payroll">Payroll register</option><option value="Deductions">Deductions applied / waived</option><option value="Bank">Bank payment list</option></select></label><label>From<input asp-for="From" type="date"/></label><label>To<input asp-for="To" type="date"/></label><label>Branch<select asp-for="BranchId"><option value="">All authorized branches</option>@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select></label><label>Department<select asp-for="DepartmentId"><option value="">All</option>@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name</option>}</select></label><label>Sub-department<select asp-for="SubDepartmentId"><option value="">All</option>@foreach(var d in Model.SubDepartments){<option value="@d.Id">@d.Name</option>}</select></label><label>Payroll period<select asp-for="PeriodId"><option value="">Select period</option>@foreach(var p in Model.Periods){<option value="@p.Id">@p.From.ToString("MMM yyyy") · @p.Status</option>}</select></label></div><button>View report</button> <button name="format" value="csv">Download CSV</button> <button name="format" value="excel">Download Excel (.xlsx)</button> <button type="button" onclick="window.print()">Print / PDF</button></form><div class="card table-scroll"><h2>@Model.Report</h2><table>@for(var i=0;i<Model.Rows.Count;i++){<tr>@foreach(var cell in Model.Rows[i]){@if(i==0){<th>@cell</th>}else{<td>@cell</td>}}</tr>}</table></div>