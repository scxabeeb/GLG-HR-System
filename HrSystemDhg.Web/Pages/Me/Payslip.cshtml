@page
@model HrSystemDhg.Web.Pages.Me.PayslipModel
@{
    ViewData["Title"] = "Payslip";
    var line = Model.Line;
    var rows = new (string Label, decimal Amount)[]
    {
        ("Basic salary", line.Basic), ("Allowances", line.AllowanceTotal),
        ("Approved overtime", line.Overtime), ("Gross earnings", line.Gross),
        ("Attendance deductions", line.AttendanceApplied), ("Unpaid leave", line.UnpaidLeave)
    };
}
<div class="actions no-print">
    @if (User.IsInRole("Management") || User.IsInRole("Admin"))
    {
        <a class="button secondary" asp-area="Management" asp-page="/Payroll" asp-route-periodId="@Model.Period.Id">Back to payroll</a>
    }
    else
    {
        <a class="button secondary" asp-page="./Profile">My workspace</a>
    }
    <button type="button" onclick="window.print()">Print / save as PDF</button>
</div>
<article class="card payslip payroll-document">
    <header class="payroll-detail-heading">
        <div>
            <h1>Payslip</h1>
            <p>Garowe Local Government</p>
            <p>@Model.Period.From.ToString("dd MMM yyyy") – @Model.Period.To.ToString("dd MMM yyyy")</p>
        </div>
        <img src="~/images/garowe-local-government.jpg" alt="Garowe Local Government seal" width="64" height="64" />
    </header>
    <dl class="payroll-summary">
        <div><dt>Employee</dt><dd>@Model.Employee.FullName</dd></div>
        <div><dt>Employee number</dt><dd>@Model.Employee.EmployeeNumber</dd></div>
        <div><dt>Net payable</dt><dd>@line.Currency @line.Net.ToString("N2")</dd></div>
    </dl>
    <h2>Pay breakdown</h2>
    <table>
        <thead><tr><th scope="col">Pay item</th><th scope="col">Amount (@line.Currency)</th></tr></thead>
        <tbody>
        @foreach (var row in rows)
        {
            <tr><th scope="row">@row.Label</th><td>@row.Amount.ToString("N2")</td></tr>
        }
        </tbody>
    </table>
    <p>Calculated attendance deductions @line.AttendanceCalculated.ToString("N2") · Waived @Math.Max(0, line.AttendanceCalculated - line.AttendanceApplied).ToString("N2")</p>
    @if (line.NetOverride.HasValue) { <p>Manual net adjustment · @line.OverrideReason</p> }
    <small>Revision @line.Revision</small>
</article>
