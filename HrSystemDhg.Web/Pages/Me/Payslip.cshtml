@page
@model HrSystemDhg.Web.Pages.Me.PayslipModel
@{ViewData["Title"]="Payslip";}
<div class="eyebrow">GAROWE HR WORKSPACE</div><h1>Payslip</h1>
<div asp-validation-summary="All"></div>
<article class="card payslip"><div class="slip-heading"><img src="~/images/garowe-local-government.jpg" alt="Garowe Local Government" width="90"/><div><h2>Garowe Local Government</h2><p>Employee payslip · @Model.Period.From.ToString("dd MMM yyyy") – @Model.Period.To.ToString("dd MMM yyyy")</p></div></div><h2>@Model.Employee.FullName</h2><p>@Model.Employee.EmployeeNumber · Revision @Model.Line.Revision</p><table><tr><td>Basic salary</td><td>@Model.Line.Basic.ToString("N2")</td></tr><tr><td>Allowances</td><td>@Model.Line.AllowanceTotal.ToString("N2")</td></tr><tr><td>Approved overtime</td><td>@Model.Line.Overtime.ToString("N2")</td></tr><tr><td>Gross earnings</td><td>@Model.Line.Gross.ToString("N2")</td></tr><tr><td>Attendance deductions</td><td>@Model.Line.AttendanceApplied.ToString("N2")</td></tr><tr><td>Unpaid leave</td><td>@Model.Line.UnpaidLeave.ToString("N2")</td></tr><tr><td><strong>Net payable</strong></td><td><strong>@Model.Line.Currency @Model.Line.Net.ToString("N2")</strong></td></tr></table><p>Calculated attendance deductions: @Model.Line.AttendanceCalculated.ToString("N2"). Waived: @((Model.Line.AttendanceCalculated-Model.Line.AttendanceApplied).ToString("N2"))</p>@if(Model.Line.NetOverride!=null){<p>Manual net adjustment: @Model.Line.OverrideReason</p>}<button class="no-print" onclick="window.print()">Print / save as PDF</button></article>