@page
@inject HrSystemDhg.Web.Services.ModuleAccess MenuAccess
@model HrSystemDhg.Web.Pages.Operations.TasksModel
@{ ViewData["Title"] = "Task manager"; }
@if (Model.FocusedTask is { } focused)
{
    <section class="card focused-task">
        <h1>@(focused.Responsibility ?? focused.Title)</h1>
        @if (focused.Responsibility != null) { <p>Team task · @focused.Title</p> }
        <p>@(focused.DueDate is { } due ? $"Due {due:dd MMM yyyy}" : "No due date") · @focused.Priority priority</p>
        @if (!string.IsNullOrWhiteSpace(focused.Description)) { <p class="ops-description">@focused.Description</p> }
        @if (TempData["OperationsNotice"] is string updateNotice) { <p class="notice" role="status">@updateNotice</p> }
        @if (focused.Status != TaskProgress.Cancelled)
        {
            <form method="post" asp-page-handler="Progress" asp-route-id="@focused.Id" asp-route-focus="@focused.Id">
                <label>Status<select name="status">
                    @foreach (var status in Enum.GetValues<TaskProgress>().Where(s => s != TaskProgress.Cancelled))
                    {
                        <option value="@status" selected="@(status == focused.Status)">@HrSystemDhg.Web.Pages.Operations.TaskReportModel.Label(status)</option>
                    }
                </select></label>
                <button>Save status</button>
            </form>
        }
        else { <p>Cancelled</p> }
        <a asp-page="./TaskReport" asp-route-taskId="@focused.Id">Activity history</a>
    </section>
}
else
{
<div class="eyebrow">OPERATIONS / WORK</div>
<h1>@(Model.View == "created" ? "Manage tasks" : "Task manager")</h1>


<p class="muted">Find assigned work, follow team progress, or create a task. Expand a subtask to see each employee’s responsibility.</p>
<div class="actions">
    <a class="button" href="#tasks-create" menu-permission="tasks.manage">+ Create task</a>
    <a class="button secondary" asp-page="./TaskReport">Task progress report</a>
    <a class="button @(Model.View == "related" ? "" : "secondary")" asp-page="./Tasks" asp-route-view="related">All my work</a>
    <a class="button @(Model.View == "mine" ? "" : "secondary")" asp-page="./Tasks" asp-route-view="mine">My tasks</a>
    <a class="button @(Model.View == "created" ? "" : "secondary")" asp-page="./Tasks" asp-route-view="created">Created by me</a>
    @if (Model.IsAdmin) { <a class="button @(Model.View == "all" ? "" : "secondary")" asp-page="./Tasks" asp-route-view="all">All tasks</a> }
</div>
@if (TempData["OperationsNotice"] is string notice) { <p class="notice" role="status">@notice</p> }

<div class="page-workspace" data-page-workspace><nav class="workspace-tabs" aria-label="Task views"><a href="#tasks-list" data-workspace-link>Task list</a><a href="#tasks-create" menu-permission="tasks.manage" data-workspace-link>Create / edit task</a><a href="#tasks-import" menu-permission="tasks.manage" data-workspace-link>Import &amp; export</a><a href="/Operations/TaskReport">Progress reports</a></nav>
<section id="tasks-list" data-workspace-panel><div class="card workspace-list compact-task-list">
    <header class="workspace-list-heading"><h2>Tasks</h2><small>@Model.Items.Count assignments shown</small></header>
    <form method="get" class="task-list-filters">
        <input type="hidden" name="view" value="@Model.View" />
        <label>Search<input asp-for="Search" type="search" maxlength="120" placeholder="Task, description, or employee" /></label>
        <label>Task type<select asp-for="Kind"><option value="">All types</option><option value="individual">Individual</option><option value="team">Team</option></select></label>
        <label>Status<select asp-for="Filter" asp-items="Html.GetEnumSelectList<TaskProgress>()"><option value="">All statuses</option></select></label>
        <label>Priority<select asp-for="PriorityFilter" asp-items="Html.GetEnumSelectList<TaskPriority>()"><option value="">All priorities</option></select></label>
        <button>Apply filters</button>
        <a asp-page="./Tasks" asp-route-view="@Model.View">Clear</a>
    </form>
    @if (Model.Items.Count == 0 && Model.EmptyTeams.Count == 0) { <p>No tasks in this view.</p> }
    @{
        var individualTasks = Model.Items.Where(t => t.Team == null).ToList();
        var teamTasks = Model.Items.Where(t => t.Team != null).GroupBy(t => t.TeamId!.Value).ToList();
    }
    @if (individualTasks.Count > 0) {
        <section class="task-list-section">
            <h3>Individual tasks</h3>
            <div class="ops-list">
                @foreach (var task in individualTasks) {
                    <partial name="_TaskAssignment" model="(Model, task, true)" />
                }
            </div>
        </section>
    }
    @if (teamTasks.Count > 0 || Model.EmptyTeams.Count > 0) {
    <section class="task-list-section">
    <h3>Team tasks</h3>
    <div class="ops-list">
    @foreach (var team in Model.EmptyTeams) {
        <div class="task-parent">
            <span class="badge">Team task</span><h3>@team.Title</h3>
            @if (team.Brief != null) { <p class="ops-description">@team.Brief</p> }
            @if (Model.TeamRosters.TryGetValue(team.Id, out var roster)) {
                <p><strong>Assigned employees</strong> @string.Join(", ", roster)</p>
            }
            <partial name="_TeamTaskProgress" model="(Model.TeamProgress.GetValueOrDefault(team.Id), Model.IsAdmin || team.OwnerId == Model.Actor)" />
            <p>No subtasks in this view yet.</p>
            @if (team.OwnerId == Model.Actor && Model.CanAssign) {
                <a class="button" asp-page="./TaskReport" asp-route-teamId="@team.Id" asp-fragment="subtask-form">Add subtasks</a>
            } else {
                <a asp-page="./TaskReport" asp-route-teamId="@team.Id">Open team task</a>
            }
        </div>
    }
    @foreach (var group in teamTasks) {
        var parent = group.First().Team!;
        var subtasks = group.GroupBy(t => t.SubtaskId ?? -t.Id).ToList();
        var teamDueDates = group.Select(t => t.DueDate).OfType<DateTime>().Distinct().Order().ToArray();
        var teamEmployees = Model.TeamRosters.GetValueOrDefault(parent.Id)
            ?? group.Select(t => t.AssigneeId).Distinct().Select(Model.PersonName).Order().ToArray();
        <section class="task-parent">
            <header class="task-team-header">
                <div>
                    <span class="badge">Team task</span>
                    <h3>@parent.Title</h3>
                    @if (!string.IsNullOrWhiteSpace(parent.Brief)) { <p class="ops-description">@parent.Brief</p> }
                    <dl class="task-visible-meta">
                        <div><dt>@(Model.TeamRosters.ContainsKey(parent.Id) ? "Assigned employees" : "Assignees in this view")</dt><dd>@string.Join(", ", teamEmployees)</dd></div>
                        <div><dt>Subtask due dates in this view</dt><dd>@(teamDueDates.Length == 0 ? "No due dates" : teamDueDates.Length == 1 ? teamDueDates[0].ToString("dd MMM yyyy") : $"{teamDueDates[0]:dd MMM yyyy} – {teamDueDates[^1]:dd MMM yyyy}")</dd></div>
                    </dl>
                </div>
                <div class="task-team-actions">
                    @if (Model.IsAdmin || parent.OwnerId == Model.Actor || group.Any(t => t.AssigneeId == Model.Actor)) {
                        <a class="button secondary" asp-page="./TaskReport" asp-route-teamId="@parent.Id">Team progress</a>
                    }
                    @if (parent.OwnerId == Model.Actor && Model.CanAssign) {
                        <a class="button" asp-page="./TaskReport" asp-route-teamId="@parent.Id" asp-fragment="subtask-form">Add subtasks</a>
                    }
                </div>
            </header>
            <partial name="_TeamTaskProgress" model="(Model.TeamProgress.GetValueOrDefault(parent.Id), Model.IsAdmin || parent.OwnerId == Model.Actor)" />
            <div class="task-subtasks">
                @foreach (var subtask in subtasks) {
                    var first = subtask.First();
                    var complete = subtask.Count(t => t.Status == TaskProgress.Done);
                    var active = subtask.Count(t => t.Status != TaskProgress.Cancelled);
                    var dueDates = subtask.Select(t => t.DueDate).Distinct().ToArray();
                    var descriptions = subtask.Select(t => t.Description).Distinct().ToArray();
                    <details class="task-subtask" open="@(descriptions.Length > 1 || dueDates.Length > 1)">
                        <summary>
                            <strong>@(first.Responsibility ?? first.Title)</strong>
                            @if (descriptions.Length == 1 && !string.IsNullOrWhiteSpace(descriptions[0])) {
                                <span class="task-visible-description">@descriptions[0]</span>
                            }
                            <span class="task-visible-meta">
                                <span><strong>Assigned to</strong> @string.Join(", ", subtask.Select(t => t.AssigneeId).Distinct().Select(Model.PersonName))</span>
                                <span><strong>Due</strong> @(dueDates.Length > 1 ? "Varies by employee" : dueDates[0]?.ToString("dd MMM yyyy") ?? "No due date")</span>
                            </span>
                            <small>@complete / @active shown assignments complete</small>
                        </summary>
                        <div class="task-subtask-assignments">
                            @foreach (var task in subtask) {
                                <partial name="_TaskAssignment" model="(Model, task, descriptions.Length > 1)" />
                            }
                        </div>
                    </details>
                }
            </div>
        </section>
    }
    </div>
    </section>
    }
</div>
</section>
@if (HrSystemDhg.Web.Services.MenuPermissions.Allows(await MenuAccess.BlockedAsync(), "tasks.manage")) {
<section id="tasks-create" data-workspace-panel data-workspace-auto><details id="task-editor" class="card task-create-panel workspace-tools" open="@(Model.Input.Id != 0 || !ViewData.ModelState.IsValid)">
<summary>@(Model.Input.Id == 0 ? "Create a task" : "Edit task")</summary>
<form method="post" asp-page-handler="Save">
    <div asp-validation-summary="All"></div>
    <input asp-for="Input.Id" type="hidden" />
    <div class="grid">
        <label>Task title<input asp-for="Input.Title" required maxlength="160" readonly="@Model.EditingTeamAssignment" /></label>
        <label class="task-single-setting">Due date<input asp-for="Input.DueDate" type="date" /></label>
        <label class="task-single-setting">Priority<select asp-for="Input.Priority" asp-items="Html.GetEnumSelectList<TaskPriority>()"></select></label>
        @if (Model.CanAssign && Model.Input.Id != 0) {
            <label>Assign to<select asp-for="Input.AssigneeId">
                @if (!Model.EditingTeamAssignment) { <option value="">Myself</option> }
                @foreach (var person in Model.AssignmentOptions.Where(p => Model.EditingTeamAssignment || p.Key != Model.Actor)) { <option value="@person.Key">@person.Value</option> }
            </select></label>
        }
    </div>
    @if (Model.CanAssign && Model.Input.Id == 0) {
        <fieldset class="task-type-picker">
            <legend>Task type</legend>
            <label><input type="radio" asp-for="Input.DivideWork" value="false" id="task-type-individual" /> Individual task <small>Each selected employee receives their own task.</small></label>
            <label><input type="radio" asp-for="Input.DivideWork" value="true" id="task-type-team" /> Team task <small>One parent task with subtasks assigned to team members.</small></label>
        </fieldset>
        <fieldset>
            <legend>Assign to employees</legend>
            <div class="checkbox-list">
                <label><input asp-for="Input.AssignToAll" /> Select all eligible employees</label>
            </div>
            <label>Assign by department
                <select asp-for="Input.DepartmentId">
                    <option value="">No department selected</option>
                    @foreach (var department in Model.Departments)
                    {
                        <option value="@department.Id">@department.Label</option>
                    }
                </select>
            </label>
            <p>Select a department to assign the task to its eligible employees. Check Myself to add yourself.</p>
            <p>Select all includes active employee accounts in your branch scope that have Task Manager access. Check Myself to include your own assignment.</p>
            <div class="ops-participants team-assignees">
                @foreach (var person in new[] { new KeyValuePair<string, string>(Model.Actor, "Myself") }.Concat(Model.Assignable.Where(p => p.Key != Model.Actor))) {
                    <div class="team-assignee">
                        <label class="inline"><input type="checkbox" name="Input.AssigneeIds" value="@person.Key" checked="@Model.Input.AssigneeIds.Contains(person.Key)" /> @person.Value</label>
                    </div>
                }
            </div>
        </fieldset>
    }
    @if (Model.EditingTeamAssignment) { <label>Responsibility<textarea asp-for="Input.Responsibility" maxlength="1000" rows="3" readonly="@Model.SharedSubtask" required></textarea></label> }
    <label>Details<textarea asp-for="Input.Description" rows="3" maxlength="2500"></textarea></label>
    <button id="save-task-button">Save task</button> @if (Model.Input.Id != 0) { <a asp-page="./Tasks">Cancel edit</a> }
</form>
</details></section>
}

@if (HrSystemDhg.Web.Services.MenuPermissions.Allows(await MenuAccess.BlockedAsync(), "tasks.manage")) {
<section id="tasks-import" data-workspace-panel><partial name="/Pages/Shared/_RegistrationCsv.cshtml" model='("tasks")' /></section>
}
</div>

}

@section Scripts {
    <script src="~/js/team-task.js" asp-append-version="true" defer></script>
    <script>
        function openLinkedTask() {
            const id = location.hash.slice(1);
            if (!/^task-\d+$/.test(id)) return;
            const task = document.getElementById(id);
            if (!(task instanceof HTMLDetailsElement)) return;
            for (let details = task; details; details = details.parentElement?.closest('details')) {
                details.open = true;
            }
            task.scrollIntoView({ block: 'nearest' });
        }
        openLinkedTask();
        window.addEventListener('hashchange', openLinkedTask);
    </script>
}
